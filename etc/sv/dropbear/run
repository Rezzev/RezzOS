#!/bin/sh

mkdir -p /etc/dropbear /var/log

for t in rsa ecdsa ed25519; do
    k="/etc/dropbear/dropbear_${t}_host_key"
    [ -s "$k" ] && continue
    if [ -s "/mnt/disk/etc/dropbear/dropbear_${t}_host_key" ]; then
        cp -f "/mnt/disk/etc/dropbear/dropbear_${t}_host_key" "$k" 2>/dev/null || true
    else
        dropbearkey -t "$t" -f "$k" >/dev/null 2>&1 || true
    fi
done

if [ -d /mnt/disk/etc ]; then
    mkdir -p /mnt/disk/etc/dropbear
    cp -f /etc/dropbear/dropbear_*_host_key /mnt/disk/etc/dropbear/ 2>/dev/null || true
fi

exec /usr/sbin/dropbear -F -E -R >/var/log/dropbear.log 2>&1 </dev/null
