<?xml version="1.0"?>
<JWM>
  <!-- Start Menu (Left Click) -->
  <IconPath>/usr/share/icons/RezzOS</IconPath>
<RootMenu onroot="3">
  <Program label="Create File...">create_file.sh</Program>
  <Program label="Create Folder...">create_folder.sh</Program>
  <Separator/>
  <Menu label="Programs">
    <Program label="Terminal">st</Program>
    <Program label="Rtop">rtopg</Program>
    <Program label="Rsv">rsv-gui</Program>
  </Menu>
  <Separator/>
  <Program label="Configuration">rezzconfig</Program>
  <Program label="Install on disk">rezzinstall</Program>
  <Program label="About System">rezzabout</Program>
</RootMenu>


  <!-- Options for program interfaces. -->
  <Tray x="0" y="1" autohide="off">
    <TrayButton label="_">showdesktop</TrayButton>
    <Spacer width="2"/>
    <Pager labeled="false"/>
    <TaskList maxwidth="40"/>
    <Dock/>
    <Clock format="%d.%m.%Y %H:%M"/>
  </Tray>

  <!-- Visual Styles  -->
  <WindowStyle>
    <Font>monospace-10</Font>
    <Width>1</Width>
    <Height>20</Height>
    <Corner>0</Corner>
    <Opacity>1.0</Opacity>
    <Foreground>#000000</Foreground>
    <Background>#FFFFEA</Background>
    <Outline>#000000</Outline>
    <Active>
      <Foreground>#000000</Foreground>
      <Background>#99CCFF</Background>
      <Outline>#0000AA</Outline>
    </Active>
  </WindowStyle>

  <TrayStyle group="false" list="desktop">
    <Opacity>1.0</Opacity>
    <Font>monospace-10</Font>
    <Outline>#000000</Outline> <!-- Черная рамка панели -->
    <Foreground>#000000</Foreground> <!-- Черный текст часов и окон -->
    <Background>#FFFFFF</Background> <!-- Белый фон панели -->
    <Active>
      <Outline>#000000</Outline>
      <Foreground>#FFFFFF</Foreground> <!-- Белый текст активного окна на панели -->
      <Background>#000000</Background> <!-- Черный фон активного окна на панели -->
    </Active>
  </TrayStyle>

  <PagerStyle>
    <Outline>#000000</Outline> <!-- Черная рамка переключателя -->
    <Foreground>#000000</Foreground>
    <Background>#FFFFFF</Background> <!-- Белый фон неактивных столов -->
    <Text>#000000</Text>
    <Active>
      <Foreground>#FFFFFF</Foreground>
      <Background>#000000</Background> <!-- Черный фон активного стола -->
    </Active>
  </PagerStyle>

  <MenuStyle>
    <Font>monospace-13</Font>
    <Foreground>#000000</Foreground> <!-- Черный текст в меню по ПКМ -->
    <Background>#FFFFFF</Background> <!-- Белый фон меню -->
    <Outline>#000000</Outline> <!-- Черная рамка меню -->
    <Active>
      <Foreground>#FFFFFF</Foreground> <!-- Белый текст выбранного пункта -->
      <Background>#000000</Background> <!-- Черный фон выбранного пункта -->
    </Active>
  </MenuStyle>

  <PopupStyle>
    <Font>monospace-12</Font>
    <Foreground>#000000</Foreground> <!-- Черный текст подсказок -->
    <Background>#FFFFFF</Background> <!-- Белый фон подсказок -->
  </PopupStyle>

  <!-- Virtual Desktops -->
  <Desktops width="4" height="1">
    <Background type="solid">#FFFFFF</Background>
  </Desktops>

  <Group>
    <Class>*</Class>
    <Option>noborder</Option>
    <Option>notitle</Option>
  </Group>

  <!-- Key bindings -->
  <Key key="Up">up</Key>
  <Key key="Down">down</Key>
  <Key key="Right">right</Key>
  <Key key="Left">left</Key>
  <Key key="h">left</Key>
  <Key key="j">down</Key>
  <Key key="k">up</Key>
  <Key key="l">right</Key>
  <Key key="Return">select</Key>
  <Key key="Escape">escape</Key>
  <Key mask="A" key="Tab">nextstacked</Key>
  <Key mask="W" key="q">close</Key>
  <Key mask="A" key="F1">root:3</Key>
  <Key mask="A" key="F2">window</Key>
  <Key mask="A" key="F10">maximize</Key>
  <Key mask="A" key="Right">rdesktop</Key>
  <Key mask="A" key="Left">ldesktop</Key>
  <Key mask="A" key="Up">udesktop</Key>
  <Key mask="A" key="Down">ddesktop</Key>
  <Key mask="CA" key="t">exec:st</Key>
  <Mouse context="window" modifier="A" button="1">move</Mouse>
</JWM>
