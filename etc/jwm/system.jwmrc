<?xml version="1.0"?>
<JWM>
  <!-- Start Menu (Left Click) -->
  <IconPath>/usr/share/icons/RezzOS</IconPath>

  <!-- Desktop Context Menu (Right Click) -->
  <RootMenu onroot="3">
    <Program label="Create File...">create_file.sh</Program>
    <Program label="Create Folder...">create_folder.sh</Program>
    <Separator/>
    <Program label="File Manager">pcmanfm -n</Program>
    <Program label="Browser">rezzbrowser</Program>
    <Program label="Terminal">st</Program>
    <Separator/>
    <Program label="Install on disk">rezzinstall</Program>
    <Program label="Rtop">rtopg</Program>
  </RootMenu>

  <!-- Options for program interfaces. -->
  <Tray x="0" y="-1" autohide="off">
    <TrayButton label="_">showdesktop</TrayButton>
    <Spacer width="2"/>
    <Pager labeled="false"/>
    <TaskList maxwidth="40"/>
    <Dock/>
    <Clock format="%d.%m.%Y %H:%M"/>
  </Tray>

  <!-- Visual Styles (Plan 9 / 9front-inspired) -->
  <WindowStyle>
    <Font>monospace-10</Font>
    <Width>1</Width>
    <Height>20</Height>
    <Corner>0</Corner>
    <Opacity>1.0</Opacity>
    <Foreground>#000000</Foreground>
    <Background>#FFFFEA</Background>
    <Outline>#000000</Outline>
    <Active>
      <Foreground>#000000</Foreground>
      <Background>#99CCFF</Background>
      <Outline>#0000AA</Outline>
    </Active>
  </WindowStyle>

  <TrayStyle group="false" list="desktop">
    <Opacity>1.0</Opacity>
    <Font>monospace-10</Font>
    <Outline>#000000</Outline>
    <Foreground>#000000</Foreground>
    <Background>#FFFFFF</Background> <!-- Белая панель -->
    <Active>
      <Outline>#0000AA</Outline>
      <Foreground>#000000</Foreground>
      <Background>#99CCFF</Background>
    </Active>
  </TrayStyle>

  <PagerStyle>
    <Outline>#000000</Outline>
    <Foreground>#000000</Foreground>
    <Background>#FFFFFF</Background> <!-- Белый переключатель (был #FFFFEA) -->
    <Text>#000000</Text>
    <Active>
      <Foreground>#FFFFFF</Foreground>
      <Background>#0000AA</Background>
    </Active>
  </PagerStyle>

  <MenuStyle>
    <Font>monospace-13</Font>
    <Foreground>#000000</Foreground>
    <Background>#FFFFEA</Background>
    <Outline>#000000</Outline>
    <Active>
      <Foreground>#FFFFFF</Foreground>
      <Background>#0000AA</Background>
    </Active>
  </MenuStyle>

  <PopupStyle>
    <Font>monospace-12</Font>
    <Foreground>#000000</Foreground>
    <Background>#FFFFEA</Background>
  </PopupStyle>

  <!-- Rules for Applications (Icons on Taskbar and Window Titles) -->
  <!-- Terminal (st) -->
  <Group>
    <Class>st-256color</Class>
    <Class>st</Class>
    <Class>St</Class>
    <Option>icon:terminal.png</Option>
  </Group>

  <!-- Browser (rezzbrowser) -->
  <Group>
    <Class>rezzbrowser</Class>
    <Class>Rezzbrowser</Class>
    <Option>icon:browser.png</Option>
  </Group>

  <!-- File Manager (PCManFM) -->
  <Group>
    <Class>pcmanfm</Class>
    <Class>Pcmanfm</Class>
    <Class>PCManFM</Class>
    <Option>icon:folder.png</Option>
  </Group>

  <!-- Text Editor (edit) -->
  <Group>
    <Class>edit</Class>
    <Class>Edit</Class>
    <Option>icon:notepad.png</Option>
  </Group>

  <!-- System Monitor (rtopg) -->
  <Group>
    <Class>rtopg</Class>
    <Class>Rtopg</Class>
    <Option>icon:monitor.png</Option>
  </Group>

  <!-- Image Viewer (rezzview) -->
  <Group>
    <Class>rezzview</Class>
    <Class>Rezzview</Class>
    <Option>icon:view.png</Option>
  </Group>

  <!-- Service Manager (rsv-gui) -->
  <Group>
    <Class>rsv-gui</Class>
    <Class>Rsv-gui</Class>
    <Option>icon:manager.png</Option>
  </Group>

  <!-- Settings Configuration (rezzconfig) -->
  <Group>
    <Class>rezzconfig</Class>
    <Class>Rezzconfig</Class>
    <Option>icon:settings.png</Option>
  </Group>

  <!-- OS Installer (rezzinstall) -->
  <Group>
    <Class>rezzinstall</Class>
    <Class>Rezzinstall</Class>
    <Option>icon:install.png</Option>
  </Group>

  <!-- Virtual Desktops -->
  <Desktops width="4" height="1">
    <Background type="solid">#FFFFEA</Background>
  </Desktops>

  <!-- Key bindings -->
  <Key key="Up">up</Key>
  <Key key="Down">down</Key>
  <Key key="Right">right</Key>
  <Key key="Left">left</Key>
  <Key key="h">left</Key>
  <Key key="j">down</Key>
  <Key key="k">up</Key>
  <Key key="l">right</Key>
  <Key key="Return">select</Key>
  <Key key="Escape">escape</Key>
  <Key mask="A" key="Tab">nextstacked</Key>
  <Key mask="A" key="F4">close</Key>
  <Key mask="A" key="F1">root:3</Key>
  <Key mask="A" key="F2">window</Key>
  <Key mask="A" key="F10">maximize</Key>
  <Key mask="A" key="Right">rdesktop</Key>
  <Key mask="A" key="Left">ldesktop</Key>
  <Key mask="A" key="Up">udesktop</Key>
  <Key mask="A" key="Down">ddesktop</Key>
  <Key mask="CA" key="t">exec:st</Key>
</JWM>
