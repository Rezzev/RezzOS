<?xml version="1.0"?>
<JWM>
    <!-- Start Menu (Left Click) -->
    <IconPath>/usr/share/icons/RezzOS</IconPath>
    <RootMenu onroot="1">
        <Program icon="browser.png" label="Links browser">links -g duckduckgo.com</Program>
        <Program icon="/usr/share/icons/RezzOS/folder.png" label="File Manager">pcmanfm -n</Program>
        <Program icon="/usr/share/icons/RezzOS/rezzpad.png" label="Notepad">rezzpad</Program>
        <Program icon="/usr/share/icons/RezzOS/terminal.png" label="Terminal">st</Program>
        <Program icon="/usr/share/icons/RezzOS/rview.png" label="Image viewer">rezzview</Program>
        <Program icon="/usr/share/icons/RezzOS/rtop.png" label="Task Manager">st -e rtop</Program>
        <Separator/>
        <Menu icon="/usr/share/icons/RezzOS/info.png" label="Power">
            <Program label="Suspend">sh -c 'zenity --info --title="RezzOS" --text="Suspending..." --timeout=2 &amp; suspend'</Program>
            <Program label="Hibernate">sh -c 'zenity --info --title="RezzOS" --text="Hibernating..." --timeout=3 &amp; hibernate'</Program>
            <Program label="Reboot">sh -c 'zenity --info --title="RezzOS" --text="Rebooting..." --timeout=5 &amp; reboot'</Program>
            <Program label="Shutdown">sh -c 'zenity --info --title="RezzOS" --text="Shutting down..." --timeout=5 &amp; poweroff'</Program>
            <Separator/>
            <Restart label="Restart JWM"/>
            <Exit label="Log Out of GUI" confirm="true"/>
        </Menu>
    </RootMenu>

    <!-- Desktop Context Menu (Right Click) -->
    <RootMenu onroot="3">
        <Program label="Create File...">create_file.sh</Program>
        <Program label="Create Folder...">create_folder.sh</Program>
        <Separator/>
        <Program label="Open File Manager Here">pcmanfm -n</Program>
        <Program label="Open Terminal Here">st</Program>
        <Separator/>
        <Program label="System Info">sysinfo.sh</Program>
    </RootMenu>

    <!-- Options for program interfaces. -->
    <Tray x="0" y="0" autohide="off">
        <!-- FIXED: Removed jwm-blue icon and changed action to root:1 to open the Start menu -->
        <TrayButton label="Menu">root:1</TrayButton>
        <Spacer width="2"/>
        <!-- FIXED: Action changed to "desktop" so the "_" button minimizes all windows -->
        <TrayButton label="_">showdesktop</TrayButton>
        <Spacer width="2"/>
        <Pager labeled="true"/>
        <TaskList maxwidth="256"/>
        <Dock/>
        <Clock format="%d.%m.%Y %H:%M"></Clock>
    </Tray>

    <!-- Visual Styles -->
    <!-- FIXED: Added missing `<` character to WindowStyle tag -->
    <WindowStyle>
        <Font>Noto NotoSans-11:bold</Font>
        <Width>4</Width>
        <Height>21</Height>
        <Corner>3</Corner>
        <!-- FIXED: <Foreground> replaced with <Text> -->
        <Text>#FFFFFF</Text>
        <Background>#555555</Background>
        <Outline>#000000</Outline>
        <Opacity>1</Opacity>
        <Active>
            <!-- FIXED: <Foreground> replaced with <Text> -->
            <Text>#FFFFFF</Text>
            <Background>#404552</Background>
            <Outline>#000000</Outline>
            <Opacity>1</Opacity>
        </Active>
        <!-- FIXED: Standart window management buttons (Iconify, Maximize, Close) -->
        <Buttons>imx</Buttons>
    </WindowStyle>
    
    <TrayStyle group="true" list="all">
        <Font>NotoSans-11</Font>
        <Background>#383c4a</Background>
        <Foreground>#FFFFFF</Foreground>
        <Outline>#000000</Outline>
        <Opacity>0.9</Opacity>
    </TrayStyle>
    
    <TaskListStyle>
      <Font>NotoSans-11</Font>
      <Active>
        <Foreground>#FFFFFF</Foreground>
        <Background>#555555</Background>
      </Active>
      <Foreground>#FFFFFF</Foreground>
      <Background>#333333</Background>
    </TaskListStyle>
    
    <PagerStyle>
        <Outline>#000000</Outline>
        <Foreground>#555555</Foreground>
        <Background>#333333</Background>
        <Text>#FFFFFF</Text>
        <Active>
            <Foreground>#0077CC</Foreground>
            <Background>#004488</Background>
        </Active>
    </PagerStyle>
    
    <MenuStyle>
        <Font>NotoSans-11</Font>
        <Foreground>#FFFFFF</Foreground>
        <Background>#333333</Background>
        <Outline>#000000</Outline>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#5294e2</Background>
        </Active>
        <Opacity>0.9</Opacity>
    </MenuStyle>
    
    <PopupStyle>
        <Font>NotoSans-11</Font>
        <Foreground>#000000</Foreground>
        <Background>#999999</Background>
    </PopupStyle>

    <!-- Virtual Desktops -->
    <Desktops width="4" height="1">
        <!-- Default background -->
        <Background type="solid">#112233</Background>
    </Desktops>

    <!-- Key bindings -->
    <Key key="Up">up</Key>
    <Key key="Down">down</Key>
    <Key key="Right">right</Key>
    <Key key="Left">left</Key>
    <Key key="h">left</Key>
    <Key key="j">down</Key>
    <Key key="k">up</Key>
    <Key key="l">right</Key>
    <Key key="Return">select</Key>
    <Key key="Escape">escape</Key>

    <Key mask="A" key="Tab">nextstacked</Key>
    <Key mask="A" key="F4">close</Key>
    <Key mask="A" key="F1">root:3</Key>
    <Key mask="A" key="F2">window</Key>
    <Key mask="A" key="F10">maximize</Key>
    <Key mask="A" key="Right">rdesktop</Key>
    <Key mask="A" key="Left">ldesktop</Key>
    <Key mask="A" key="Up">udesktop</Key>
    <Key mask="A" key="Down">ddesktop</Key>
    <Key mask="CA" key="t">exec:st</Key>
</JWM>
