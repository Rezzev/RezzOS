#!/bin/sh

RECOVERY_DIR="/var/lib/rezz"
RECOVERY_FLAG="$RECOVERY_DIR/recovery"
SVDIR="/etc/runit/runsvdir/default"

die()
{
    echo "rezzrecovery: $*" >&2
    exit 1
}

need_root()
{
    [ "$(id -u)" = "0" ] || die "this command requires root"
}

usage()
{
    echo "usage:"
    echo "  rezzrecovery status"
    echo "  rezzrecovery enter"
    echo "  rezzrecovery leave"
    echo "  rezzrecovery shell"
    echo "  rezzrecovery services"
    echo "  rezzrecovery mounts"
    echo "  rezzrecovery logs"
    echo "  rezzrecovery reboot"
    echo "  rezzrecovery poweroff"
}

status()
{
    echo "RezzOS recovery status"
    echo

    if [ -f "$RECOVERY_FLAG" ]; then
        echo "recovery mode: enabled"
    else
        echo "recovery mode: disabled"
    fi

    echo
    echo "root filesystem:"
    mount | grep ' on / ' || true

    echo
    echo "services:"
    if [ -d "$SVDIR" ]; then
        for service in "$SVDIR"/*; do
            [ -e "$service" ] || continue
            echo "  ${service##*/}"
        done
    else
        echo "  no service directory"
    fi
}

enter_recovery()
{
    need_root

    mkdir -p "$RECOVERY_DIR"
    date > "$RECOVERY_FLAG"

    echo "recovery mode enabled"
    echo "reboot the system to enter recovery mode"
}

leave_recovery()
{
    need_root

    rm -f "$RECOVERY_FLAG"

    echo "recovery mode disabled"
}

shell()
{
    need_root

    echo "RezzOS recovery shell"
    echo "type exit to leave"

    exec /bin/sh
}

services()
{
    echo "services:"

    if [ ! -d "$SVDIR" ]; then
        echo "  no services"
        return
    fi

    for service in "$SVDIR"/*; do
        [ -e "$service" ] || continue

        name="${service##*/}"

        if command -v sv >/dev/null 2>&1; then
            printf "  %-20s " "$name"
            sv status "$name" 2>/dev/null || echo "unknown"
        else
            echo "  $name"
        fi
    done
}

mounts()
{
    mount
}

logs()
{
    if [ -d /var/log ]; then
        ls -la /var/log
    else
        echo "no log directory"
    fi
}

reboot_system()
{
    need_root
    reboot
}

poweroff_system()
{
    need_root
    poweroff
}

case "$1" in
    status)
        status
        ;;
    enter)
        enter_recovery
        ;;
    leave)
        leave_recovery
        ;;
    shell)
        shell
        ;;
    services)
        services
        ;;
    mounts)
        mounts
        ;;
    logs)
        logs
        ;;
    reboot)
        reboot_system
        ;;
    poweroff)
        poweroff_system
        ;;
    help|-h|--help|"")
        usage
        ;;
    *)
        die "unknown command '$1'"
        ;;
esac
