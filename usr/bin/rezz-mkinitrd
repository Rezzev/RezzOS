#!/bin/sh
# Build a bootable initramfs from the running system.
#
# RezzOS runs entirely from its initramfs, so the live root filesystem is the
# image. That also means the image can never contain a copy of itself: any
# rootfs.cpio.gz shipped inside /boot is necessarily the previous build, and on
# a first build there is none at all. The README's install-to-disk steps need
# that file on the target, so build it here, from the system you are running,
# where it is current by construction.

GREEN=$(printf '\033[1;32m')
YELLOW=$(printf '\033[1;33m')
RED=$(printf '\033[1;31m')
NC=$(printf '\033[0m')

OUT="${1:-/mnt/boot/rootfs.cpio.gz}"

case "$1" in
    -h|--help)
        echo "Usage: rezz-mkinitrd [output.cpio.gz]"
        echo ""
        echo "Packs the running system into an initramfs image."
        echo "Defaults to /mnt/boot/rootfs.cpio.gz, the path the install"
        echo "steps in the README expect on the mounted target disk."
        exit 0
        ;;
esac

OUT_DIR=$(dirname "$OUT")
if [ ! -d "$OUT_DIR" ]; then
    echo -e "${RED}No such directory: $OUT_DIR${NC}"
    echo "Mount the target disk first, then create it, for example:"
    echo "  mount /dev/sda1 /mnt && mkdir -p /mnt/boot"
    exit 1
fi

# Writing the image into the initramfs would spend RAM equal to the image
# itself, on a system whose entire root filesystem already lives in RAM.
# /proc/mounts tells us whether the destination is on real storage.
OUT_REAL=$(cd "$OUT_DIR" 2>/dev/null && pwd)
ON_DISK=0
while read -r _dev _mnt _type _rest; do
    case "$_type" in
        tmpfs|ramfs|rootfs|devtmpfs|proc|sysfs|devpts) continue ;;
    esac
    case "$OUT_REAL/" in
        "$_mnt"/*) ON_DISK=1 ;;
    esac
done < /proc/mounts

if [ "$ON_DISK" -eq 0 ]; then
    echo -e "${YELLOW}Warning: $OUT_DIR is not on a mounted disk.${NC}"
    echo "The root filesystem is the initramfs, so writing there consumes RAM"
    echo "equal to the size of the image. Point this at the target disk instead."
    echo ""
    printf "Continue anyway? [y/N] "
    read -r reply
    case "$reply" in
        y|Y) ;;
        *) echo "Cancelled."; exit 1 ;;
    esac
fi

TMP="$OUT.partial"
rm -f "$TMP"

echo -e "${YELLOW}Packing the running system into $OUT...${NC}"

# -xdev keeps the walk on the root filesystem, which drops /proc, /sys, /dev,
# /run and /mnt/disk without needing to name them: they are all separate
# mounts. The remaining exclusions are directories that belong in the image as
# empty mount points, plus the file being written.
( cd / && find . -xdev \
    -path './tmp/*'  -prune -o \
    -path './boot/rootfs.cpio.gz*' -prune -o \
    -path ".${OUT}*" -prune -o \
    -print ) \
  | cpio -o -H newc 2>/dev/null \
  | gzip -9 > "$TMP"

if [ ! -s "$TMP" ]; then
    echo -e "${RED}Failed to build the image.${NC}"
    rm -f "$TMP"
    exit 1
fi

# A rootfs without an init is not bootable, and a silent truncation halfway
# through the pipe would otherwise be discovered at the next boot.
if ! gzip -t "$TMP" 2>/dev/null; then
    echo -e "${RED}The image did not compress cleanly, discarding it.${NC}"
    rm -f "$TMP"
    exit 1
fi

if ! gzip -dc "$TMP" | cpio -t 2>/dev/null | grep -qx './init'; then
    echo -e "${RED}The image has no /init, discarding it.${NC}"
    rm -f "$TMP"
    exit 1
fi

mv "$TMP" "$OUT"
SIZE=$(du -h "$OUT" 2>/dev/null | awk '{print $1}')
echo -e "${GREEN}Wrote $OUT ($SIZE)${NC}"
