#!/bin/sh
# RezzOS System Installer (rezzinstall)
# Copyright (c) RezzOS Project

set -e

# Colors
RED=$(printf '\033[1;31m')
GREEN=$(printf '\033[1;32m')
YELLOW=$(printf '\033[1;33m')
BLUE=$(printf '\033[1;34m')
CYAN=$(printf '\033[1;36m')
MAGENTA=$(printf '\033[1;35m')
BOLD=$(printf '\033[1m')
NC=$(printf '\033[0m')

TARGET_MOUNT="/tmp/rezz_install_target"

banner() {
    clear
    echo -e "${CYAN}================================================================${NC}"
    echo -e "${MAGENTA}${BOLD}      ██████╗ ███████╗███████╗███████╗ ██████╗ ███████╗        ${NC}"
    echo -e "${MAGENTA}${BOLD}      ██╔══██╗██╔════╝╚══███╔╝╚══███╔╝██╔═══██╗██╔════╝        ${NC}"
    echo -e "${MAGENTA}${BOLD}      ██████╔╝█████╗    ███╔╝   ███╔╝ ██║   ██║███████╗        ${NC}"
    echo -e "${MAGENTA}${BOLD}      ██╔══██╗██╔══╝   ███╔╝   ███╔╝  ██║   ██║╚════██║        ${NC}"
    echo -e "${MAGENTA}${BOLD}      ██║  ██║███████╗███████╗███████╗╚██████╔╝███████║        ${NC}"
    echo -e "${MAGENTA}${BOLD}      ╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝ ╚═════╝ ╚══════╝        ${NC}"
    echo -e "${CYAN}                   RezzOS System Installer                     ${NC}"
    echo -e "${CYAN}================================================================${NC}"
    echo ""
}

check_root() {
    if [ "$(id -u)" != "0" ]; then
        echo -e "${RED}Error: rezzinstall must be run as root (sudo rezzinstall).${NC}" >&2
        exit 1
    fi
}

check_dependencies() {
    local missing=""
    for cmd in cp dd fdisk sync; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing="$missing $cmd"
        fi
    done

    if [ -n "$missing" ]; then
        echo -e "${RED}Error: Missing essential tools:$missing${NC}" >&2
        exit 1
    fi
}

read_secret() {
    local prompt="$1"
    local var_name="$2"
    local val=""

    while true; do
        printf "%s" "$prompt"
        stty -echo 2>/dev/null || true
        read -r val
        stty echo 2>/dev/null || true
        echo ""

        if [ -z "$val" ]; then
            echo -e "${RED}Password cannot be empty. Please try again.${NC}"
            continue
        fi

        printf "Confirm password: "
        stty -echo 2>/dev/null || true
        read -r val_confirm
        stty echo 2>/dev/null || true
        echo ""

        if [ "$val" != "$val_confirm" ]; then
            echo -e "${RED}Passwords do not match. Please try again.${NC}"
            continue
        fi

        eval "$var_name=\"\$val\""
        break
    done
}

get_disks() {
    # Scan for available disks excluding loop, ram, and optical drives
    local disks=""
    for d in /sys/block/*; do
        [ -e "$d" ] || continue
        local dev_name=$(basename "$d")
        case "$dev_name" in
            loop*|ram*|zram*|sr*|fd*) continue ;;
        esac

        if [ -b "/dev/$dev_name" ]; then
            disks="$disks /dev/$dev_name"
        fi
    done
    echo "$disks"
}

get_disk_size() {
    local disk="$1"
    local bytes=0
    if [ -f "/sys/block/$(basename "$disk")/size" ]; then
        local sectors=$(cat "/sys/block/$(basename "$disk")/size" 2>/dev/null || echo 0)
        bytes=$((sectors * 512))
    elif command -v blockdev >/dev/null 2>&1; then
        bytes=$(blockdev --getsize64 "$disk" 2>/dev/null || echo 0)
    fi

    if [ "$bytes" -ge 1073741824 ]; then
        echo "$((bytes / 1073741824)) GB"
    elif [ "$bytes" -ge 1048576 ]; then
        echo "$((bytes / 1048576)) MB"
    else
        echo "${bytes} B"
    fi
}

get_disk_model() {
    local disk="$1"
    local dev_name=$(basename "$disk")
    local model="Disk"
    if [ -f "/sys/block/$dev_name/device/model" ]; then
        model=$(cat "/sys/block/$dev_name/device/model" 2>/dev/null | tr -s ' ' | sed 's/^[ \t]*//;s/[ \t]*$//')
    fi
    echo "$model"
}

select_target() {
    local DISKS=$(get_disks)

    if [ -z "$DISKS" ]; then
        echo -e "${RED}Error: No suitable storage disks detected.${NC}"
        exit 1
    fi

    echo -e "${BOLD}${YELLOW}Available Disks:${NC}"
    local count=1
    for d in $DISKS; do
        local sz=$(get_disk_size "$d")
        local mdl=$(get_disk_model "$d")
        local mounted=""
        if grep -q "^$d" /proc/mounts 2>/dev/null; then
            mounted="${RED}(Currently Mounted)${NC}"
        fi
        printf "  ${CYAN}[%d]${NC} %-14s %-10s %-20s %s\n" "$count" "$d" "$sz" "[$mdl]" "$mounted"
        eval "DISK_$count=\"$d\""
        count=$((count + 1))
    done
    local total_disks=$((count - 1))

    echo ""
    while true; do
        printf "Select disk to install RezzOS on [1-%d] (or 'q' to quit): " "$total_disks"
        read -r choice
        case "$choice" in
            [qQ]*) echo -e "${YELLOW}Installation aborted.${NC}"; exit 0 ;;
            *)
                if [ -n "$choice" ] && [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "$total_disks" ] 2>/dev/null; then
                    eval "CHOSEN_DISK=\"\$DISK_$choice\""
                    break
                else
                    echo -e "${RED}Invalid selection. Please try again.${NC}"
                fi
                ;;
        esac
    done

    echo -e "Selected target disk: ${GREEN}$CHOSEN_DISK${NC}"
    echo ""
}

select_partition_mode() {
    echo -e "${BOLD}${YELLOW}Partitioning Options:${NC}"
    echo "  1) Wipe disk and create new MBR partition table (Entire Disk - Recommended)"
    echo "  2) Install to an existing partition (Advanced)"
    echo ""
    printf "Choose mode [1-2] (default: 1): "
    read -r part_mode
    [ -z "$part_mode" ] && part_mode="1"

    if [ "$part_mode" = "1" ]; then
        AUTO_PART=1
        if echo "$CHOSEN_DISK" | grep -q -E '(nvme|mmcblk)'; then
            TARGET_PART="${CHOSEN_DISK}p1"
        else
            TARGET_PART="${CHOSEN_DISK}1"
        fi
    else
        AUTO_PART=0
        echo -e "\n${BOLD}Existing partitions on $CHOSEN_DISK:${NC}"
        ls -l "${CHOSEN_DISK}"* 2>/dev/null || fdisk -l "$CHOSEN_DISK" 2>/dev/null || true
        echo ""
        while true; do
            printf "Enter target partition (e.g. %s1): " "$CHOSEN_DISK"
            read -r manual_part
            if [ -b "$manual_part" ]; then
                TARGET_PART="$manual_part"
                break
            else
                echo -e "${RED}Error: Partition '$manual_part' does not exist.${NC}"
            fi
        done
    fi
}

initial_setup_wizard() {
    echo ""
    echo -e "${CYAN}----------------------------------------------------------------${NC}"
    echo -e "${BOLD}${MAGENTA}             Initial System Configuration Setup                 ${NC}"
    echo -e "${CYAN}----------------------------------------------------------------${NC}"
    echo ""

    # 1. Hostname
    printf "Enter hostname for this machine [default: rezzos]: "
    read -r input_hn
    [ -z "$input_hn" ] && input_hn="rezzos"
    # Sanitize hostname
    CFG_HOSTNAME=$(echo "$input_hn" | tr -cd 'a-zA-Z0-9.-')
    [ -z "$CFG_HOSTNAME" ] && CFG_HOSTNAME="rezzos"
    echo -e "Hostname set to: ${GREEN}$CFG_HOSTNAME${NC}\n"

    # 2. Root password
    echo -e "${YELLOW}Set password for administrator (root):${NC}"
    read_secret "Enter root password: " CFG_ROOT_PASS
    echo -e "${GREEN}Root password set successfully.${NC}\n"

    # 3. Regular user setup
    echo -e "${YELLOW}Create regular user account:${NC}"
    while true; do
        printf "Enter username [default: user]: "
        read -r input_user
        [ -z "$input_user" ] && input_user="user"
        CFG_USERNAME=$(echo "$input_user" | tr -cd 'a-z0-9_-')
        if [ -z "$CFG_USERNAME" ] || [ "$CFG_USERNAME" = "root" ]; then
            echo -e "${RED}Invalid username. Use lowercase letters, digits, and underscores.${NC}"
            continue
        fi
        break
    done

    read_secret "Enter password for '$CFG_USERNAME': " CFG_USER_PASS
    echo -e "${GREEN}User '$CFG_USERNAME' configured successfully.${NC}\n"

    # 4. Keyboard Layout
    echo -e "${YELLOW}Keyboard & Language Layout:${NC}"
    echo "  1) US English only"
    echo "  2) US / RU (Toggle: Alt + Shift) [Recommended]"
    echo "  3) US / RU (Toggle: Caps Lock)"
    echo "  4) US / RU (Toggle: Ctrl + Shift)"
    printf "Select keyboard layout [1-4] (default: 2): "
    read -r kb_choice
    [ -z "$kb_choice" ] && kb_choice="2"

    case "$kb_choice" in
        1)
            CFG_KEYMAP="us"
            CFG_KEYMAP_OPT=""
            ;;
        3)
            CFG_KEYMAP="us,ru"
            CFG_KEYMAP_OPT="grp:caps_toggle,grp_led:scroll"
            ;;
        4)
            CFG_KEYMAP="us,ru"
            CFG_KEYMAP_OPT="grp:ctrl_shift_toggle,grp_led:scroll"
            ;;
        2|*)
            CFG_KEYMAP="us,ru"
            CFG_KEYMAP_OPT="grp:alt_shift_toggle,grp_led:scroll"
            ;;
    esac
    echo -e "Keyboard layout: ${GREEN}$CFG_KEYMAP ($CFG_KEYMAP_OPT)${NC}\n"

    # 5. Console Font
    echo -e "${YELLOW}Console Font:${NC}"
    echo "  1) TER16x32 (Large, high-DPI readable) [Recommended]"
    echo "  2) SUN12x22 (Medium crisp font)"
    echo "  3) 8x16     (Classic VGA)"
    printf "Select console font [1-3] (default: 1): "
    read -r font_choice
    [ -z "$font_choice" ] && font_choice="1"

    case "$font_choice" in
        2) CFG_FONT="SUN12x22" ;;
        3) CFG_FONT="8x16" ;;
        1|*) CFG_FONT="TER16x32" ;;
    esac
    echo -e "Console font: ${GREEN}$CFG_FONT${NC}\n"
}

confirm_installation() {
    echo -e "${CYAN}================================================================${NC}"
    echo -e "${BOLD}${YELLOW}                     Installation Summary                       ${NC}"
    echo -e "${CYAN}================================================================${NC}"
    printf "  Target Disk:      ${GREEN}%s${NC}\n" "$CHOSEN_DISK"
    printf "  Target Partition: ${GREEN}%s${NC}\n" "$TARGET_PART"
    printf "  Partition Mode:   ${GREEN}%s${NC}\n" "$([ "$AUTO_PART" = "1" ] && echo "Entire Disk (Wipe & Create MBR)" || echo "Existing Partition")"
    printf "  Hostname:         ${GREEN}%s${NC}\n" "$CFG_HOSTNAME"
    printf "  Root Password:    ${GREEN}[Configured]${NC}\n"
    printf "  User Account:     ${GREEN}%s${NC}\n" "$CFG_USERNAME"
    printf "  Keyboard Layout:  ${GREEN}%s (%s)${NC}\n" "$CFG_KEYMAP" "$CFG_KEYMAP_OPT"
    printf "  Console Font:     ${GREEN}%s${NC}\n" "$CFG_FONT"
    echo -e "${CYAN}----------------------------------------------------------------${NC}"
    echo -e "${RED}${BOLD}WARNING: ALL DATA ON $TARGET_PART (AND $CHOSEN_DISK) WILL BE ERASED!${NC}"
    echo ""
    printf "Are you sure you want to proceed with installation? Type '${BOLD}yes${NC}' to continue: "
    read -r confirm
    if [ "$confirm" != "yes" ] && [ "$confirm" != "YES" ]; then
        echo -e "${YELLOW}Installation cancelled by user.${NC}"
        exit 0
    fi
}

hash_password() {
    local pass="$1"
    if command -v cryptpw >/dev/null 2>&1; then
        printf "%s\n" "$pass" | cryptpw -m sha-512 2>/dev/null || printf "%s\n" "$pass" | cryptpw 2>/dev/null
    elif command -v mkpasswd >/dev/null 2>&1; then
        mkpasswd -m sha-512 "$pass" 2>/dev/null
    elif command -v openssl >/dev/null 2>&1; then
        openssl passwd -6 "$pass" 2>/dev/null
    else
        # Fallback
        echo "$pass"
    fi
}

perform_installation() {
    echo ""
    echo -e "${CYAN}================================================================${NC}"
    echo -e "${BOLD}${GREEN}                   Starting Installation...                     ${NC}"
    echo -e "${CYAN}================================================================${NC}"

    # Step 1: Unmount target partition and disk if mounted
    echo -e "\n[1/7] ${BOLD}Preparing storage device...${NC}"
    for mount_pt in $(grep "$CHOSEN_DISK" /proc/mounts 2>/dev/null | awk '{print $2}'); do
        umount -f "$mount_pt" 2>/dev/null || true
    done
    for p in "${CHOSEN_DISK}"* "${CHOSEN_DISK}p"*; do
        [ -b "$p" ] || continue
        umount -f "$p" 2>/dev/null || true
    done
    umount -f "$TARGET_MOUNT" 2>/dev/null || true
    mkdir -p "$TARGET_MOUNT"

    # Step 2: Partitioning if auto mode selected
    if [ "$AUTO_PART" = "1" ]; then
        echo -e "[2/7] ${BOLD}Writing MBR partition table to $CHOSEN_DISK...${NC}"
        # Wipe first 1MB of partition table
        dd if=/dev/zero of="$CHOSEN_DISK" bs=512 count=2048 2>/dev/null || true
        sync

        local part_ok=0
        if command -v sfdisk >/dev/null 2>&1; then
            if echo ',,L,*' | sfdisk "$CHOSEN_DISK" >/dev/null 2>&1; then
                part_ok=1
            fi
        fi

        if [ "$part_ok" -eq 0 ]; then
            printf "o\nn\np\n1\n\n\na\nw\n" | fdisk "$CHOSEN_DISK" >/dev/null 2>&1 && part_ok=1 || true
        fi

        if [ "$part_ok" -eq 0 ]; then
            printf "o\nn\np\n1\n\n\nw\n" | fdisk "$CHOSEN_DISK" >/dev/null 2>&1 && part_ok=1 || true
        fi

        if [ "$part_ok" -eq 0 ]; then
            echo -e "${RED}Failed to partition disk with fdisk.${NC}"
            exit 1
        fi

        # Re-read partition table
        blockdev --rereadpt "$CHOSEN_DISK" 2>/dev/null || true
        sync
        sleep 1

        # Wait for target partition device node to appear
        for i in 1 2 3 4 5; do
            [ -b "$TARGET_PART" ] && break
            sleep 0.5
        done

        if [ ! -b "$TARGET_PART" ]; then
            if [ -b "${CHOSEN_DISK}1" ]; then
                TARGET_PART="${CHOSEN_DISK}1"
            elif [ -b "${CHOSEN_DISK}p1" ]; then
                TARGET_PART="${CHOSEN_DISK}p1"
            fi
        fi
    else
        echo -e "[2/7] ${BOLD}Using existing partition $TARGET_PART...${NC}"
    fi

    # Step 3: Formatting filesystem
    echo -e "[3/7] ${BOLD}Formatting $TARGET_PART as ext4...${NC}"
    if command -v mkfs.ext4 >/dev/null 2>&1; then
        mkfs.ext4 -F -L "REZZOS" "$TARGET_PART" >/dev/null 2>&1 || {
            echo -e "${RED}Formatting failed.${NC}"
            exit 1
        }
    elif command -v mke2fs >/dev/null 2>&1; then
        mke2fs -t ext4 -F -L "REZZOS" "$TARGET_PART" >/dev/null 2>&1 || {
            echo -e "${RED}Formatting failed.${NC}"
            exit 1
        }
    else
        echo -e "${RED}Error: Neither mkfs.ext4 nor mke2fs is available.${NC}"
        exit 1
    fi

    # Step 4: Mounting filesystem
    echo -e "[4/7] ${BOLD}Mounting target filesystem to $TARGET_MOUNT...${NC}"
    mount -t ext4 "$TARGET_PART" "$TARGET_MOUNT"

    # Step 5: Copying system files
    echo -e "[5/7] ${BOLD}Copying system files to target...${NC}"
    for dir in bin sbin usr etc lib var boot root; do
        if [ -d "/$dir" ]; then
            printf "  Copying /%-6s ... " "$dir"
            cp -a "/$dir" "$TARGET_MOUNT/" 2>/dev/null || true
            echo -e "${GREEN}Done${NC}"
        fi
    done

    # Ensure essential directories exist
    mkdir -p "$TARGET_MOUNT/dev" "$TARGET_MOUNT/proc" "$TARGET_MOUNT/sys" \
             "$TARGET_MOUNT/tmp" "$TARGET_MOUNT/run" "$TARGET_MOUNT/mnt/disk" \
             "$TARGET_MOUNT/home" "$TARGET_MOUNT/boot" "$TARGET_MOUNT/var/log" \
             "$TARGET_MOUNT/mnt/disk/packages" "$TARGET_MOUNT/mnt/disk/services"
    chmod 1777 "$TARGET_MOUNT/tmp"

    # Ensure init script is installed
    [ -f /init ] && cp -f /init "$TARGET_MOUNT/init" && chmod +x "$TARGET_MOUNT/init"

    # Step 6: Applying configuration
    echo -e "[6/7] ${BOLD}Configuring system, users and localization...${NC}"

    # Hostname
    echo "$CFG_HOSTNAME" > "$TARGET_MOUNT/etc/hostname"
    cat > "$TARGET_MOUNT/etc/hosts" << EOF
127.0.0.1   localhost $CFG_HOSTNAME
::1         localhost ip6-localhost ip6-loopback
EOF

    # Font
    echo "FONT=$CFG_FONT" > "$TARGET_MOUNT/etc/font.conf"
    echo "FONT=$CFG_FONT" > "$TARGET_MOUNT/mnt/disk/font.conf" 2>/dev/null || true

    # Keymap
    cat > "$TARGET_MOUNT/etc/keymap.conf" << EOF
LAYOUT="$CFG_KEYMAP"
TOGGLE="$CFG_KEYMAP_OPT"
EOF

    # Passwords and Users
    ROOT_HASH=$(hash_password "$CFG_ROOT_PASS")
    USER_HASH=$(hash_password "$CFG_USER_PASS")

    # /etc/passwd
    cat > "$TARGET_MOUNT/etc/passwd" << EOF
root:x:0:0:root:/root:/bin/bash
$CFG_USERNAME:x:1000:1000:$CFG_USERNAME:/home/$CFG_USERNAME:/bin/bash
nobody:x:65534:65534:nobody:/:/sbin/nologin
EOF

    # /etc/group
    cat > "$TARGET_MOUNT/etc/group" << EOF
root:x:0:root
wheel:x:10:root,$CFG_USERNAME
sudo:x:27:root,$CFG_USERNAME
audio:x:29:$CFG_USERNAME
video:x:44:$CFG_USERNAME
input:x:107:$CFG_USERNAME
$CFG_USERNAME:x:1000:
nobody:x:65534:
EOF

    # /etc/shadow
    cat > "$TARGET_MOUNT/etc/shadow" << EOF
root:$ROOT_HASH:19800:0:99999:7:::
$CFG_USERNAME:$USER_HASH:19800:0:99999:7:::
nobody:*:19800:0:99999:7:::
EOF
    chmod 0600 "$TARGET_MOUNT/etc/shadow"

    # User Home Directory
    mkdir -p "$TARGET_MOUNT/home/$CFG_USERNAME"
    if [ -d "$TARGET_MOUNT/etc/skel" ]; then
        cp -a "$TARGET_MOUNT/etc/skel/." "$TARGET_MOUNT/home/$CFG_USERNAME/" 2>/dev/null || true
    fi
    chown -R 1000:1000 "$TARGET_MOUNT/home/$CFG_USERNAME" 2>/dev/null || true
    chmod 755 "$TARGET_MOUNT/home/$CFG_USERNAME"

    # Persistent storage mirrors (for init script compatibility)
    mkdir -p "$TARGET_MOUNT/mnt/disk/etc" "$TARGET_MOUNT/mnt/disk/home"
    cp -f "$TARGET_MOUNT/etc/hostname" "$TARGET_MOUNT/mnt/disk/etc/hostname" 2>/dev/null || true
    cp -f "$TARGET_MOUNT/etc/passwd" "$TARGET_MOUNT/mnt/disk/etc/passwd" 2>/dev/null || true
    cp -f "$TARGET_MOUNT/etc/shadow" "$TARGET_MOUNT/mnt/disk/etc/shadow" 2>/dev/null || true
    cp -f "$TARGET_MOUNT/etc/group" "$TARGET_MOUNT/mnt/disk/etc/group" 2>/dev/null || true
    cp -f "$TARGET_MOUNT/etc/keymap.conf" "$TARGET_MOUNT/mnt/disk/etc/keymap.conf" 2>/dev/null || true

    # Step 7: Installing Bootloader (Syslinux / Extlinux)
    echo -e "[7/7] ${BOLD}Installing bootloader...${NC}"
    mkdir -p "$TARGET_MOUNT/boot"

    # Create extlinux.conf
    cat > "$TARGET_MOUNT/boot/extlinux.conf" << EOF
DEFAULT rezzos
PROMPT 0
TIMEOUT 20

LABEL rezzos
    MENU LABEL RezzOS Linux (6.6.40)
    LINUX /boot/bzImage
    APPEND quiet loglevel=0 nokaslr fbcon=font:$CFG_FONT
    INITRD /boot/rootfs.cpio.gz
EOF

    # Install extlinux
    if command -v extlinux >/dev/null 2>&1; then
        extlinux --install "$TARGET_MOUNT/boot" >/dev/null 2>&1 || true
    fi

    # Write MBR boot code
    if [ -f /usr/share/syslinux/mbr.bin ]; then
        dd if=/usr/share/syslinux/mbr.bin of="$CHOSEN_DISK" bs=440 count=1 conv=notrunc >/dev/null 2>&1 || true
    fi

    echo -e "  ${GREEN}Syncing and unmounting target disk...${NC}"
    sync
    umount "$TARGET_MOUNT" 2>/dev/null || true
    rmdir "$TARGET_MOUNT" 2>/dev/null || true

    echo ""
    echo -e "${CYAN}================================================================${NC}"
    echo -e "${BOLD}${GREEN}        RezzOS has been successfully installed! 🎉              ${NC}"
    echo -e "${CYAN}================================================================${NC}"
    echo -e "Installed on: ${GREEN}$TARGET_PART${NC}"
    echo -e "Hostname:     ${GREEN}$CFG_HOSTNAME${NC}"
    echo -e "User account: ${GREEN}$CFG_USERNAME${NC}"
    echo ""
    echo -e "You can now remove the installation media and reboot your computer."
    echo ""

    printf "Reboot now? [y/N]: "
    read -r do_reboot
    case "$do_reboot" in
        [yY]*)
            echo -e "${YELLOW}Rebooting system...${NC}"
            sync
            reboot -f
            ;;
        *)
            echo -e "${GREEN}Exiting installer. Run 'reboot' when you are ready.${NC}"
            ;;
    esac
}

main() {
    banner
    check_root
    check_dependencies
    select_target
    select_partition_mode
    initial_setup_wizard
    confirm_installation
    perform_installation
}

main "$@"
