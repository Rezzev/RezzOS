#!/bin/sh
# RezzOS System Installer (rezzinstall)
# Copyright (c) RezzOS Project

set -e

# Colors
RED=$(printf '\033[1;31m')
GREEN=$(printf '\033[1;32m')
YELLOW=$(printf '\033[1;33m')
BLUE=$(printf '\033[1;34m')
CYAN=$(printf '\033[1;36m')
MAGENTA=$(printf '\033[1;35m')
BOLD=$(printf '\033[1m')
NC=$(printf '\033[0m')

TARGET_MOUNT="/tmp/rezz_install_target"

banner() {
    clear
    echo -e "${CYAN}================================================================${NC}"
    echo -e "${MAGENTA}${BOLD}      ██████╗ ███████╗███████╗███████╗ ██████╗ ███████╗        ${NC}"
    echo -e "${MAGENTA}${BOLD}      ██╔══██╗██╔════╝╚══███╔╝╚══███╔╝██╔═══██╗██╔════╝        ${NC}"
    echo -e "${MAGENTA}${BOLD}      ██████╔╝█████╗    ███╔╝   ███╔╝ ██║   ██║███████╗        ${NC}"
    echo -e "${MAGENTA}${BOLD}      ██╔══██╗██╔══╝   ███╔╝   ███╔╝  ██║   ██║╚════██║        ${NC}"
    echo -e "${MAGENTA}${BOLD}      ██║  ██║███████╗███████╗███████╗╚██████╔╝███████║        ${NC}"
    echo -e "${MAGENTA}${BOLD}      ╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝ ╚═════╝ ╚══════╝        ${NC}"
    echo -e "${CYAN}                   RezzOS System Installer                     ${NC}"
    echo -e "${CYAN}================================================================${NC}"
    echo ""
}

check_root() {
    if [ "$(id -u)" != "0" ]; then
        echo -e "${RED}Error: rezzinstall must be run as root (sudo rezzinstall).${NC}" >&2
        exit 1
    fi
}

check_dependencies() {
    local missing=""
    for cmd in cp dd sync sfdisk grub-install mkfs.ext4; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing="$missing $cmd"
        fi
    done

    if [ -n "$missing" ]; then
        echo -e "${RED}Error: Missing essential tools:$missing${NC}" >&2
        exit 1
    fi
}

read_secret() {
    local prompt="$1"
    local var_name="$2"
    local val=""

    while true; do
        printf "%s" "$prompt"
        stty -echo 2>/dev/null || true
        read -r val
        stty echo 2>/dev/null || true
        echo ""

        if [ -z "$val" ]; then
            echo -e "${RED}Password cannot be empty. Please try again.${NC}"
            continue
        fi

        printf "Confirm password: "
        stty -echo 2>/dev/null || true
        read -r val_confirm
        stty echo 2>/dev/null || true
        echo ""

        if [ "$val" != "$val_confirm" ]; then
            echo -e "${RED}Passwords do not match. Please try again.${NC}"
            continue
        fi

        eval "$var_name=\"\$val\""
        break
    done
}

get_disks() {
    # Scan for available disks excluding loop, ram, and optical drives
    local disks=""
    for d in /sys/block/*; do
        [ -e "$d" ] || continue
        local dev_name=$(basename "$d")
        case "$dev_name" in
            loop*|ram*|zram*|sr*|fd*) continue ;;
        esac

        if [ -b "/dev/$dev_name" ]; then
            disks="$disks /dev/$dev_name"
        fi
    done
    echo "$disks"
}

get_disk_size() {
    local disk="$1"
    local bytes=0
    if [ -f "/sys/block/$(basename "$disk")/size" ]; then
        local sectors=$(cat "/sys/block/$(basename "$disk")/size" 2>/dev/null || echo 0)
        bytes=$((sectors * 512))
    elif command -v blockdev >/dev/null 2>&1; then
        bytes=$(blockdev --getsize64 "$disk" 2>/dev/null || echo 0)
    fi

    if [ "$bytes" -ge 1073741824 ]; then
        echo "$((bytes / 1073741824)) GB"
    elif [ "$bytes" -ge 1048576 ]; then
        echo "$((bytes / 1048576)) MB"
    else
        echo "${bytes} B"
    fi
}

get_disk_model() {
    local disk="$1"
    local dev_name=$(basename "$disk")
    local model="Disk"
    if [ -f "/sys/block/$dev_name/device/model" ]; then
        model=$(cat "/sys/block/$dev_name/device/model" 2>/dev/null | tr -s ' ' | sed 's/^[ \t]*//;s/[ \t]*$//')
    fi
    echo "$model"
}

select_target() {
    local DISKS=$(get_disks)

    if [ -z "$DISKS" ]; then
        echo -e "${RED}Error: No suitable storage disks detected.${NC}"
        exit 1
    fi

    echo -e "${BOLD}${YELLOW}Available Disks:${NC}"
    local count=1
    for d in $DISKS; do
        local sz=$(get_disk_size "$d")
        local mdl=$(get_disk_model "$d")
        local mounted=""
        if grep -q "^$d" /proc/mounts 2>/dev/null; then
            mounted="${RED}(Currently Mounted)${NC}"
        fi
        printf "  ${CYAN}[%d]${NC} %-14s %-10s %-20s %s\n" "$count" "$d" "$sz" "[$mdl]" "$mounted"
        eval "DISK_$count=\"$d\""
        count=$((count + 1))
    done
    local total_disks=$((count - 1))

    echo ""
    while true; do
        printf "Select disk to install RezzOS on [1-%d] (or 'q' to quit): " "$total_disks"
        read -r choice
        case "$choice" in
            [qQ]*) echo -e "${YELLOW}Installation aborted.${NC}"; exit 0 ;;
            *)
                if [ -n "$choice" ] && [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "$total_disks" ] 2>/dev/null; then
                    eval "CHOSEN_DISK=\"\$DISK_$choice\""
                    break
                else
                    echo -e "${RED}Invalid selection. Please try again.${NC}"
                fi
                ;;
        esac
    done

    echo -e "Selected target disk: ${GREEN}$CHOSEN_DISK${NC}"
    echo ""
}

select_layout() {
    # Firmware decides the partition table: BIOS boots from MBR, UEFI needs
    # GPT plus a FAT32 ESP. Everything else about the layout is fixed.
    if [ -d /sys/firmware/efi ]; then
        FW="uefi"
        echo -e "${BOLD}${YELLOW}Partitioning Options:${NC}"
        echo "  Automatic GPT layout on the whole disk:"
        echo "    p1  EFI system partition   256 MB"
        echo "    p2  RezzOS root            rest minus data below"
        echo "    p3  RezzOS data (/mnt/disk)"
    else
        FW="bios"
        echo -e "${BOLD}${YELLOW}Partitioning Options:${NC}"
        echo "  Automatic MBR layout on the whole disk:"
        echo "    p1  RezzOS root (bootable) rest minus data below"
        echo "    p2  RezzOS data (/mnt/disk)"
    fi

    printf "Data partition size [default: half the free space, e.g. 20G]: "
    read -r DATA_SIZE_INPUT
    DATA_SECTORS=""
    case "$DATA_SIZE_INPUT" in
        "") ;;
        *[!0-9GgMm]*|*[0-9]*[!0-9GgMm]*)
            echo -e "${RED}Invalid size '$DATA_SIZE_INPUT'. Use e.g. 20G or 512M.${NC}"
            exit 1 ;;
        *G|*g) n=${DATA_SIZE_INPUT%[Gg]}; DATA_SECTORS=$((n * 2097152)) ;;
        *M|*m) n=${DATA_SIZE_INPUT%[Mm]}; DATA_SECTORS=$((n * 2048)) ;;
    esac
}

initial_setup_wizard() {
    echo ""
    echo -e "${CYAN}----------------------------------------------------------------${NC}"
    echo -e "${BOLD}${MAGENTA}             Initial System Configuration Setup                 ${NC}"
    echo -e "${CYAN}----------------------------------------------------------------${NC}"
    echo ""

    # 1. Hostname
    printf "Enter hostname for this machine [default: rezzos]: "
    read -r input_hn
    [ -z "$input_hn" ] && input_hn="rezzos"
    # Sanitize hostname
    CFG_HOSTNAME=$(echo "$input_hn" | tr -cd 'a-zA-Z0-9.-')
    [ -z "$CFG_HOSTNAME" ] && CFG_HOSTNAME="rezzos"
    echo -e "Hostname set to: ${GREEN}$CFG_HOSTNAME${NC}\n"

    # 2. Root password
    echo -e "${YELLOW}Set password for administrator (root):${NC}"
    read_secret "Enter root password: " CFG_ROOT_PASS
    echo -e "${GREEN}Root password set successfully.${NC}\n"

    # 3. Regular user setup
    echo -e "${YELLOW}Create regular user account:${NC}"
    while true; do
        printf "Enter username [default: user]: "
        read -r input_user
        [ -z "$input_user" ] && input_user="user"
        CFG_USERNAME=$(echo "$input_user" | tr -cd 'a-z0-9_-')
        if [ -z "$CFG_USERNAME" ] || [ "$CFG_USERNAME" = "root" ]; then
            echo -e "${RED}Invalid username. Use lowercase letters, digits, and underscores.${NC}"
            continue
        fi
        break
    done

    read_secret "Enter password for '$CFG_USERNAME': " CFG_USER_PASS
    echo -e "${GREEN}User '$CFG_USERNAME' configured successfully.${NC}\n"

    # 4. Keyboard Layout
    echo -e "${YELLOW}Keyboard & Language Layout:${NC}"
    echo "  1) US English only"
    echo "  2) US / RU (Toggle: Alt + Shift) [Recommended]"
    echo "  3) US / RU (Toggle: Caps Lock)"
    echo "  4) US / RU (Toggle: Ctrl + Shift)"
    printf "Select keyboard layout [1-4] (default: 2): "
    read -r kb_choice
    [ -z "$kb_choice" ] && kb_choice="2"

    case "$kb_choice" in
        1)
            CFG_KEYMAP="us"
            CFG_KEYMAP_OPT=""
            ;;
        3)
            CFG_KEYMAP="us,ru"
            CFG_KEYMAP_OPT="grp:caps_toggle,grp_led:scroll"
            ;;
        4)
            CFG_KEYMAP="us,ru"
            CFG_KEYMAP_OPT="grp:ctrl_shift_toggle,grp_led:scroll"
            ;;
        2|*)
            CFG_KEYMAP="us,ru"
            CFG_KEYMAP_OPT="grp:alt_shift_toggle,grp_led:scroll"
            ;;
    esac
    echo -e "Keyboard layout: ${GREEN}$CFG_KEYMAP ($CFG_KEYMAP_OPT)${NC}\n"

    # 5. Console Font
    echo -e "${YELLOW}Console Font:${NC}"
    echo "  1) TER16x32 (Large, high-DPI readable) [Recommended]"
    echo "  2) SUN12x22 (Medium crisp font)"
    echo "  3) 8x16     (Classic VGA)"
    printf "Select console font [1-3] (default: 1): "
    read -r font_choice
    [ -z "$font_choice" ] && font_choice="1"

    case "$font_choice" in
        2) CFG_FONT="SUN12x22" ;;
        3) CFG_FONT="8x16" ;;
        1|*) CFG_FONT="TER16x32" ;;
    esac
    echo -e "Console font: ${GREEN}$CFG_FONT${NC}\n"
}

confirm_installation() {
    echo -e "${CYAN}================================================================${NC}"
    echo -e "${BOLD}${YELLOW}                     Installation Summary                       ${NC}"
    echo -e "${CYAN}================================================================${NC}"
    printf "  Target Disk:      ${GREEN}%s${NC}\n" "$CHOSEN_DISK"
    printf "  Firmware / Table: ${GREEN}%s (%s)${NC}\n" "$FW" "$([ "$FW" = "uefi" ] && echo GPT || echo MBR)"
    printf "  Data partition:   ${GREEN}%s${NC}\n" "$([ -n "$DATA_SECTORS" ] && echo "$((DATA_SECTORS * 512 / 1073741824)) GB" || echo "all free space")"
    printf "  Hostname:         ${GREEN}%s${NC}\n" "$CFG_HOSTNAME"
    printf "  Root Password:    ${GREEN}[Configured]${NC}\n"
    printf "  User Account:     ${GREEN}%s${NC}\n" "$CFG_USERNAME"
    printf "  Keyboard Layout:  ${GREEN}%s (%s)${NC}\n" "$CFG_KEYMAP" "$CFG_KEYMAP_OPT"
    printf "  Console Font:     ${GREEN}%s${NC}\n" "$CFG_FONT"
    echo -e "${CYAN}----------------------------------------------------------------${NC}"
    echo -e "${RED}${BOLD}WARNING: ALL DATA ON $CHOSEN_DISK WILL BE ERASED!${NC}"
    echo ""
    printf "Are you sure you want to proceed with installation? Type '${BOLD}yes${NC}' to continue: "
    read -r confirm
    if [ "$confirm" != "yes" ] && [ "$confirm" != "YES" ]; then
        echo -e "${YELLOW}Installation cancelled by user.${NC}"
        exit 0
    fi
}

hash_password() {
    local pass="$1"
    if command -v cryptpw >/dev/null 2>&1; then
        printf "%s\n" "$pass" | cryptpw -m sha-512 2>/dev/null || printf "%s\n" "$pass" | cryptpw 2>/dev/null
    elif command -v mkpasswd >/dev/null 2>&1; then
        mkpasswd -m sha-512 "$pass" 2>/dev/null
    elif command -v openssl >/dev/null 2>&1; then
        openssl passwd -6 "$pass" 2>/dev/null
    else
        echo -e "${RED}Error: no password hashing tool found (need cryptpw, mkpasswd or openssl).${NC}" >&2
        exit 1
    fi
}

perform_installation() {
    echo ""
    echo -e "${CYAN}================================================================${NC}"
    echo -e "${BOLD}${GREEN}                   Starting Installation...                     ${NC}"
    echo -e "${CYAN}================================================================${NC}"
    ROOT_HASH=$(hash_password "$CFG_ROOT_PASS")
    USER_HASH=$(hash_password "$CFG_USER_PASS")

    fail() {
        echo -e "${RED}Installation failed: $1${NC}" >&2
        [ -d "$TARGET_MOUNT/boot/efi" ] && umount "$TARGET_MOUNT/boot/efi" 2>/dev/null
        [ -d "$TARGET_MOUNT" ] && umount -f "$TARGET_MOUNT" 2>/dev/null
        exit 1
    }

    # Never wipe a disk that hosts the persistent data of the RUNNING system.
    DATA_SRC=$(awk '$2=="/mnt/disk" {print $1; exit}' /proc/mounts 2>/dev/null)
    if [ -n "$DATA_SRC" ]; then
        DATA_PARENT=$(printf '%s' "$DATA_SRC" | sed 's/[0-9]*$//; s/p$//')
        if [ "$DATA_PARENT" = "$CHOSEN_DISK" ]; then
            fail "/mnt/disk lives on $CHOSEN_DISK. Reinstall from bootable media instead."
        fi
    fi

    TOTAL_SECTORS=$(cat "/sys/block/$(basename "$CHOSEN_DISK")/size" 2>/dev/null || echo 0)
    [ "$TOTAL_SECTORS" -gt 0 ] 2>/dev/null || fail "cannot read disk size"

    if [ "$FW" = "uefi" ]; then
        ESP_SECTORS=524288   # 256 MiB ESP
        USED=$((ESP_SECTORS + 2048))
    else
        ESP_SECTORS=0
        USED=2048
    fi
    AVAILABLE=$((TOTAL_SECTORS - USED))
    # Default data partition: half of what is left after the ESP.
    [ -n "$DATA_SECTORS" ] || DATA_SECTORS=$((AVAILABLE / 2))
    # 1 MiB safety gap: an exact-to-the-last-sector layout leaves zero
    # tolerance for sfdisk's own end-of-partition alignment, and the very
    # first E2E run died on exactly that ("No free sectors available").
    SAFETY_SECTORS=2048
    ROOT_SECTORS=$((AVAILABLE - DATA_SECTORS - SAFETY_SECTORS))
    [ "$ROOT_SECTORS" -ge $((2 * 2097152)) ] 2>/dev/null || \
        fail "root partition would get only $((ROOT_SECTORS * 512 / 1073741824)) GB (need >= 2 GB). Shrink the data partition."

    case "$CHOSEN_DISK" in
        *[0-9]) SEP=p ;;
        *)      SEP="" ;;
    esac

    echo -e "\n[1/9] ${BOLD}Preparing storage device...${NC}"
    for mnt_pt in $(awk -v d="$CHOSEN_DISK" 'index($1, d) == 1 {print $2}' /proc/mounts); do
        umount -f "$mnt_pt" 2>/dev/null || true
    done
    for p in "${CHOSEN_DISK}"* "${CHOSEN_DISK}p"*; do
        [ -b "$p" ] || continue
        umount -f "$p" 2>/dev/null || true
    done
    umount -f "$TARGET_MOUNT" 2>/dev/null || true
    mkdir -p "$TARGET_MOUNT"

    # old piped interactive fdisk was fragile beyond repair.
    echo -e "[2/9] ${BOLD}Writing partition table ($([ "$FW" = uefi ] && echo GPT || echo MBR)) to $CHOSEN_DISK...${NC}"
    dd if=/dev/zero of="$CHOSEN_DISK" bs=512 count=2048 2>/dev/null || true
    sync
    PART_SCRIPT=/tmp/rezz-part.sfdisk
    if [ "$FW" = "uefi" ]; then
        cat > "$PART_SCRIPT" <<EOF
label: gpt
name=esp, size=$ESP_SECTORS, type=uefi
name=root, size=$ROOT_SECTORS, type=linux
name=data, type=linux
EOF
    else
        cat > "$PART_SCRIPT" <<EOF
label: dos
start=2048, size=$ROOT_SECTORS, type=83, bootable
type=83
EOF
    fi
    # The LAST partition deliberately has no size field: sfdisk fills the
    # remainder of the disk, so an alignment quirk can never trigger
    # "No free sectors available" again.
    # Capture sfdisk's own words: a bare non-zero exit tells nothing, and its
    # stderr is exactly what we need when this step goes red.
    SFD_OUT=$(sfdisk -f "$CHOSEN_DISK" < "$PART_SCRIPT" 2>&1) \
        || { echo "$SFD_OUT" >&2; echo "--- partition script was: ---" >&2; cat "$PART_SCRIPT" >&2; fail "partitioning with sfdisk"; }
    sync
    blockdev --rereadpt "$CHOSEN_DISK" 2>/dev/null || true
    sleep 1
    timeout 5 udevadm settle 2>/dev/null || true

    if [ "$FW" = "uefi" ]; then
        ESP_PART="${CHOSEN_DISK}${SEP}1"
        ROOT_PART="${CHOSEN_DISK}${SEP}2"
        DATA_PART="${CHOSEN_DISK}${SEP}3"
    else
        ROOT_PART="${CHOSEN_DISK}${SEP}1"
        DATA_PART="${CHOSEN_DISK}${SEP}2"
    fi
    # Ready = the node exists AND the kernel already reports a non-zero size
    # for it. A bare -b check races the partition-table refresh: mkfs then
    # opens a zero-sized node and dies without a useful message.
    wait_ready() {
        local n="$1" i=0 sz=""
        while [ "$i" -lt 20 ]; do
            if [ -b "$n" ]; then
                sz=$(cat "/sys/class/block/$(basename "$n")/size" 2>/dev/null || echo 0)
                [ "$sz" -gt 0 ] 2>/dev/null && return 0
            fi
            sleep 0.5; i=$((i+1))
        done
        fail "partition $n never became ready"
    }
    wait_ready "$ROOT_PART"
    wait_ready "$DATA_PART"
    [ "$FW" = "uefi" ] && wait_ready "$ESP_PART"

    echo -e "[3/9] ${BOLD}Creating filesystems (ext4$([ "$FW" = uefi ] && echo ", vfat"))...${NC}"
    MKFS_OUT=$(mkfs.ext4 -F -L REZZOS_ROOT "$ROOT_PART" 2>&1) \
        || { echo "$MKFS_OUT" >&2; fail "mkfs.ext4 on $ROOT_PART"; }
    MKFS_OUT=$(mkfs.ext4 -F -L REZZOS_DATA "$DATA_PART" 2>&1) \
        || { echo "$MKFS_OUT" >&2; fail "mkfs.ext4 on $DATA_PART"; }
    if [ "$FW" = "uefi" ]; then
        MKFS_OUT=$(mkdosfs -n REZZOS_EFI -F32 "$ESP_PART" 2>&1) \
            || { echo "$MKFS_OUT" >&2; fail "mkdosfs on $ESP_PART"; }
    fi

    echo -e "[4/9] ${BOLD}Mounting target filesystems...${NC}"
    mount -t ext4 "$ROOT_PART" "$TARGET_MOUNT" || fail "mount $ROOT_PART"
    if [ "$FW" = "uefi" ]; then
        mkdir -p "$TARGET_MOUNT/boot/efi"
        mount -t vfat "$ESP_PART" "$TARGET_MOUNT/boot/efi" || fail "mount $ESP_PART"
    fi

    echo -e "[5/9] ${BOLD}Copying system files...${NC}"
    for dir in bin sbin usr etc lib var boot root home; do
        [ -d "/$dir" ] || continue
        cp -a "/$dir" "$TARGET_MOUNT/" 2>/dev/null || fail "copy /$dir to target"
    done
    mkdir -p "$TARGET_MOUNT/dev" "$TARGET_MOUNT/proc" "$TARGET_MOUNT/sys" \
             "$TARGET_MOUNT/run" "$TARGET_MOUNT/tmp" "$TARGET_MOUNT/mnt/disk" \
             "$TARGET_MOUNT/var/log" "$TARGET_MOUNT/mnt/disk/packages" \
             "$TARGET_MOUNT/mnt/disk/services"
    chmod 1777 "$TARGET_MOUNT/tmp"
    [ -f /init ] && cp -f /init "$TARGET_MOUNT/init" && chmod +x "$TARGET_MOUNT/init"

    # Pre-build desktop caches so first boot does not regenerate them.
    if [ -x /usr/bin/glib-compile-schemas ]; then
        glib-compile-schemas "$TARGET_MOUNT/usr/share/glib-2.0/schemas" >/dev/null 2>&1 || true
    fi
    if [ -x /usr/bin/gdk-pixbuf-query-loaders ]; then
        gdk-pixbuf-query-loaders > "$TARGET_MOUNT/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache" 2>/dev/null || true
    fi

    echo -e "[6/9] ${BOLD}Configuring system, users and localization...${NC}"
    echo "$CFG_HOSTNAME" > "$TARGET_MOUNT/etc/hostname"
    cat > "$TARGET_MOUNT/etc/hosts" <<EOF
127.0.0.1   localhost $CFG_HOSTNAME
::1         localhost ip6-localhost ip6-loopback
EOF
    echo "FONT=$CFG_FONT" > "$TARGET_MOUNT/etc/font.conf"
    cat > "$TARGET_MOUNT/etc/keymap.conf" <<EOF
LAYOUT="$CFG_KEYMAP"
TOGGLE="$CFG_KEYMAP_OPT"
EOF

    cat > "$TARGET_MOUNT/etc/passwd" <<EOF
root:x:0:0:root:/root:/bin/bash
$CFG_USERNAME:x:1000:1000:$CFG_USERNAME:/home/$CFG_USERNAME:/bin/bash
messagebus:x:101:101:messagebus:/nonexistent:/bin/false
nobody:x:65534:65534:nobody:/:/sbin/nologin
EOF
    cat > "$TARGET_MOUNT/etc/group" <<EOF
root:x:0:root
wheel:x:10:root,$CFG_USERNAME
sudo:x:27:root,$CFG_USERNAME
audio:x:29:$CFG_USERNAME
video:x:44:$CFG_USERNAME
input:x:107:$CFG_USERNAME
messagebus:x:101:
netdev:x:102:$CFG_USERNAME
$CFG_USERNAME:x:1000:
nobody:x:65534:
EOF
    cat > "$TARGET_MOUNT/etc/shadow" <<EOF
root:$ROOT_HASH:19800:0:99999:7:::
$CFG_USERNAME:$USER_HASH:19800:0:99999:7:::
messagebus:*:19800:0:99999:7:::
nobody:*:19800:0:99999:7:::
EOF
    chmod 0600 "$TARGET_MOUNT/etc/shadow"

    mkdir -p "$TARGET_MOUNT/home/$CFG_USERNAME"
    if [ -d "$TARGET_MOUNT/etc/skel" ]; then
        cp -a "$TARGET_MOUNT/etc/skel/." "$TARGET_MOUNT/home/$CFG_USERNAME/" 2>/dev/null || true
    fi
    chown -R 1000:1000 "$TARGET_MOUNT/home/$CFG_USERNAME" 2>/dev/null || true
    chmod 755 "$TARGET_MOUNT/home/$CFG_USERNAME"

    # Root device identity for grub.cfg and fstab. GPT exposes per-partition
    # GUIDs via sfdisk -d. MBR PARTUUID is derived from the disk signature
    # (little-endian DWORD at byte 440) exactly like the kernel formats it.
    if [ "$FW" = "uefi" ]; then
        ROOT_ID=$(sfdisk -d "$CHOSEN_DISK" 2>/dev/null | awk -v d="$ROOT_PART:" '$1 == d {for(i=1;i<=NF;i++) if($i ~ /^uuid=/){sub("uuid=","",$i); print $i; exit}}')
        [ -n "$ROOT_ID" ] || fail "cannot read GPT PARTUUID of $ROOT_PART"
    else
        HEX=$(dd if="$CHOSEN_DISK" bs=1 skip=440 count=4 2>/dev/null | od -An -tx1 | tr -d ' \n')
        [ "${#HEX}" -eq 8 ] 2>/dev/null || fail "cannot read MBR disk signature"
        ROOT_ID="$(printf '%s' "$HEX" | sed 's/\(..\)\(..\)\(..\)\(..\)/\4\3\2\1/')-01"
    fi
    DATA_UUID=$(blkid "$DATA_PART" 2>/dev/null | sed -n 's/.*UUID="\([^"]*\)".*/\1/p')
    [ -n "$DATA_UUID" ] || fail "cannot read filesystem UUID of $DATA_PART"

    cat > "$TARGET_MOUNT/etc/fstab" <<EOF
PARTUUID=$ROOT_ID  /         ext4  rw,noatime   0 1
UUID=$DATA_UUID    /mnt/disk ext4  rw,noatime   0 2
EOF
    echo -e "[7/9] ${BOLD}Installing GRUB ($FW)...${NC}"
    mkdir -p "$TARGET_MOUNT/boot/grub"
    cat > "$TARGET_MOUNT/boot/grub/grub.cfg" <<EOF
set default=0
set timeout=3

menuentry "RezzOS Linux" {
    linux /boot/bzImage root=PARTUUID=$ROOT_ID rw init=/init quiet loglevel=3 console=tty0 console=ttyS0,115200n8 fbcon=font:$CFG_FONT random.trust_cpu=on
}
EOF
    if [ "$FW" = "bios" ]; then
        grub-install --boot-directory="$TARGET_MOUNT/boot" --target=i386-pc "$CHOSEN_DISK" >/dev/null 2>&1 \
            || fail "grub-install (BIOS)"
    else
        grub-install --boot-directory="$TARGET_MOUNT/boot" --efi-directory="$TARGET_MOUNT/boot/efi" \
            --target=x86_64-efi --removable --no-nvram "$CHOSEN_DISK" >/dev/null 2>&1 \
            || fail "grub-install (UEFI)"
    fi

    echo -e "[8/9] ${BOLD}Seeding persistent data partition...${NC}"
    DDIR="$TARGET_MOUNT/mnt/disk"
    mkdir -p "$DDIR/etc" "$DDIR/home" "$DDIR/packages" "$DDIR/services"
    cp -f "$TARGET_MOUNT/etc/hostname" "$DDIR/etc/hostname" 2>/dev/null || true
    cp -f "$TARGET_MOUNT/etc/keymap.conf" "$DDIR/etc/keymap.conf" 2>/dev/null || true
    cp -f "$TARGET_MOUNT/etc/font.conf" "$DDIR/etc/font.conf" 2>/dev/null || true
    cp -f "$TARGET_MOUNT/etc/passwd" "$DDIR/etc/passwd" 2>/dev/null || true
    cp -f "$TARGET_MOUNT/etc/group" "$DDIR/etc/group" 2>/dev/null || true
    cp -f "$TARGET_MOUNT/etc/shadow" "$DDIR/etc/shadow" 2>/dev/null || true
    chmod 0600 "$DDIR/etc/shadow" 2>/dev/null || true

    echo -e "[9/9] ${BOLD}Verifying installation...${NC}"
    [ -s "$TARGET_MOUNT/boot/bzImage" ]       || fail "verify: kernel image missing on target"
    [ -s "$TARGET_MOUNT/boot/grub/grub.cfg" ] || fail "verify: grub.cfg missing on target"
    grep -q "PARTUUID=$ROOT_ID" "$TARGET_MOUNT/boot/grub/grub.cfg" || fail "verify: wrong root= in grub.cfg"
    [ -x "$TARGET_MOUNT/init" ]               || fail "verify: /init missing or not executable"
    [ -s "$TARGET_MOUNT/etc/fstab" ]          || fail "verify: fstab missing"
    if [ "$FW" = "uefi" ]; then
        [ -s "$TARGET_MOUNT/boot/efi/EFI/BOOT/BOOTX64.EFI" ] || fail "verify: BOOTX64.EFI missing on ESP"
    else
        [ -f "$TARGET_MOUNT/boot/grub/i386-pc/core.img" ] || fail "verify: GRUB BIOS core.img missing"
    fi
    [ -s "$DDIR/etc/passwd" ]                 || fail "verify: data partition seeding failed"

    echo -e "  ${GREEN}Syncing and unmounting target disk...${NC}"
    sync
    [ "$FW" = "uefi" ] && umount "$TARGET_MOUNT/boot/efi" 2>/dev/null || true
    umount "$TARGET_MOUNT" 2>/dev/null || true
    rmdir "$TARGET_MOUNT" 2>/dev/null || true

    echo ""
    echo -e "${CYAN}================================================================${NC}"
    echo -e "${BOLD}${GREEN}        RezzOS has been successfully installed! 🎉              ${NC}"
    echo -e "${CYAN}================================================================${NC}"
    echo -e "Installed on: ${GREEN}$ROOT_PART${NC} (root), ${GREEN}$DATA_PART${NC} (data)"
    echo -e "Hostname:     ${GREEN}$CFG_HOSTNAME${NC}"
    echo -e "User account: ${GREEN}$CFG_USERNAME${NC}"
    echo ""
    echo -e "You can now remove the installation media and reboot your computer."
    echo ""

    printf "Reboot now? [y/N]: "
    read -r do_reboot
    case "$do_reboot" in
        [yY]*)
            echo -e "${YELLOW}Rebooting system...${NC}"
            sync
            reboot -f
            ;;
        *)
            echo -e "${GREEN}Exiting installer. Run 'reboot' when you are ready.${NC}"
            ;;
    esac
}

main() {
    banner
    check_root
    check_dependencies
    select_target
    select_layout
    initial_setup_wizard
    confirm_installation
    perform_installation
}

main "$@"
