#!/bin/sh
# RezzOS system diagnostics.
#
# Most of what can go wrong on this system goes wrong quietly. init mounts the
# persistent disk with `2>/dev/null` and carries on when it fails, udhcpc runs
# the same way, and the tools that save settings report success whether or not
# there was anywhere to save them. The result is a system that looks fine and
# silently forgets everything at the next boot.
#
# This walks the things that are actually load bearing and says which ones are
# working, so a problem can be seen instead of guessed at.

BOLD=$(printf '\033[1m')
GREEN=$(printf '\033[1;32m')
YELLOW=$(printf '\033[1;33m')
RED=$(printf '\033[1;31m')
CYAN=$(printf '\033[1;36m')
NC=$(printf '\033[0m')

PASS=0
WARN=0
FAIL=0

# Each of these ends in `return 0` on purpose. Without it the function's exit
# status is that of the `[ -n "$2" ]` test, which is 1 whenever there is no
# detail line, and callers would see a failure that did not happen.
ok() {
    PASS=$((PASS + 1))
    printf "  ${GREEN}ok${NC}    %s\n" "$1"
    return 0
}
warn() {
    WARN=$((WARN + 1))
    printf "  ${YELLOW}warn${NC}  %s\n" "$1"
    [ -n "$2" ] && printf "        %s\n" "$2"
    return 0
}
bad() {
    FAIL=$((FAIL + 1))
    printf "  ${RED}fail${NC}  %s\n" "$1"
    [ -n "$2" ] && printf "        %s\n" "$2"
    return 0
}
section() { printf "\n${BOLD}${CYAN}%s${NC}\n" "$1"; }

disk_mounted() {
    grep -q ' /mnt/disk ' /proc/mounts 2>/dev/null
}

# ---------------------------------------------------------------- persistence

section "Persistent storage"

if disk_mounted; then
    DEV=$(awk '$2 == "/mnt/disk" { print $1; exit }' /proc/mounts)
    ok "disk mounted at /mnt/disk from $DEV"

    if touch /mnt/disk/.doctor 2>/dev/null; then
        rm -f /mnt/disk/.doctor
        ok "disk is writable"
    else
        bad "disk is mounted read only" \
            "Nothing will persist. Check the kernel log for filesystem errors."
    fi

    FREE=$(df -m /mnt/disk 2>/dev/null | awk 'END { print $(NF-2) }')
    case "$FREE" in
        ''|*[!0-9]*) ;;
        *)
            if [ "$FREE" -lt 32 ]; then
                warn "only ${FREE}M free on the disk" \
                     "Installing packages or creating swap will fail."
            else
                ok "${FREE}M free on the disk"
            fi
            ;;
    esac
else
    bad "no disk mounted at /mnt/disk" \
        "Everything outside /mnt/disk is the initramfs, which is RAM. Installed packages, enabled services, the hostname and the console font will all be gone at the next boot."
fi

# ------------------------------------------------------------------- services

section "Services"

if pidof runsvdir >/dev/null 2>&1; then
    ok "runsvdir is running"

    RUN_DIR=/etc/runit/runsvdir/default
    DOWN=""
    COUNT=0
    for svc in "$RUN_DIR"/*; do
        [ -e "$svc" ] || continue
        [ -f "$svc/run" ] || continue
        COUNT=$((COUNT + 1))
        name=$(basename "$svc")
        state=$(SVDIR="$RUN_DIR" sv status "$name" 2>&1)
        case "$state" in
            run:*) ;;
            *)     DOWN="$DOWN $name" ;;
        esac
    done

    if [ "$COUNT" -eq 0 ]; then
        warn "no services are enabled"
    elif [ -n "$DOWN" ]; then
        warn "not running:$DOWN" \
             "Look at 'rsv status <name>', and /var/log for a reason."
    else
        ok "all $COUNT enabled services are running"
    fi

    # init rebuilds the symlinks in RUN_DIR from /mnt/disk/services on every
    # boot, so a service enabled without a marker there quietly disappears.
    if disk_mounted; then
        MISSING=""
        for svc in "$RUN_DIR"/*; do
            [ -e "$svc" ] || continue
            [ -f "$svc/run" ] || continue
            name=$(basename "$svc")
            [ -e "/mnt/disk/services/$name" ] || MISSING="$MISSING $name"
        done
        if [ -n "$MISSING" ]; then
            warn "enabled now but not at the next boot:$MISSING" \
                 "These have no marker in /mnt/disk/services. Re-run 'systemctl enable <name>' to make them stick."
        else
            ok "enabled services will come back after a reboot"
        fi
    fi
else
    bad "runsvdir is not running" \
        "No service is being supervised. The system reached a shell some other way."
fi

# -------------------------------------------------------------------- network

section "Network"

IFACE_UP=0
for i in /sys/class/net/*; do
    [ -e "$i" ] || continue
    n=$(basename "$i")
    [ "$n" = "lo" ] && continue
    IFACE_UP=1
    ADDR=$(ifconfig "$n" 2>/dev/null | awk '/inet /{ print $2 }' | sed 's/addr://')
    if [ -n "$ADDR" ]; then
        ok "$n has address $ADDR"
    else
        warn "$n has no address" \
             "Try 'udhcpc -i $n', or set one with rezzconfig."
    fi
done
[ "$IFACE_UP" -eq 0 ] && warn "no network interface besides loopback" \
    "The kernel may have no driver for this card. See docs/drivers.md."

if [ -n "$(ip route 2>/dev/null | grep '^default')" ] || \
   [ -n "$(route -n 2>/dev/null | awk '$1 == "0.0.0.0" { print }')" ]; then
    ok "a default route is set"
else
    warn "no default route" "Nothing outside the local network is reachable."
fi

if grep -q '^nameserver' /etc/resolv.conf 2>/dev/null; then
    NS=$(awk '/^nameserver/ { printf "%s ", $2 }' /etc/resolv.conf)
    ok "resolver configured: $NS"
else
    warn "no nameserver in /etc/resolv.conf" \
         "Names will not resolve, so 'pkg update' cannot work."
fi

# ------------------------------------------------------------------ memory

section "Memory"

MEM_TOTAL=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
MEM_AVAIL=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)
if [ -n "$MEM_TOTAL" ] && [ -n "$MEM_AVAIL" ] && [ "$MEM_TOTAL" -gt 0 ]; then
    PCT=$(( MEM_AVAIL * 100 / MEM_TOTAL ))
    if [ "$PCT" -lt 10 ]; then
        bad "only ${PCT}% of memory available ($((MEM_AVAIL / 1024))M)" \
            "The root filesystem lives in RAM, so running out takes the whole system with it."
    elif [ "$PCT" -lt 25 ]; then
        warn "${PCT}% of memory available ($((MEM_AVAIL / 1024))M)" \
             "The root filesystem lives in RAM and counts against this."
    else
        ok "${PCT}% of memory available ($((MEM_AVAIL / 1024))M)"
    fi
fi

SWAP_TOTAL=$(awk '/^SwapTotal:/ { print $2 }' /proc/meminfo)
if [ -n "$SWAP_TOTAL" ] && [ "$SWAP_TOTAL" -gt 0 ]; then
    # Swap backed by the initramfs is swap backed by RAM, which costs memory
    # rather than providing it.
    BAD_SWAP=""
    while read -r file _type _size _used _prio; do
        case "$file" in
            Filename|/dev/*) continue ;;
            /mnt/disk/*)     continue ;;
            *) BAD_SWAP="$BAD_SWAP $file" ;;
        esac
    done < /proc/swaps
    if [ -n "$BAD_SWAP" ]; then
        bad "swap file is in RAM:$BAD_SWAP" \
            "Only /mnt/disk is real storage. This consumes the memory it is meant to free. Run 'swap off' and recreate it on the disk."
    else
        ok "swap active, $((SWAP_TOTAL / 1024))M, on real storage"
    fi
else
    ok "no swap configured"
fi

# ------------------------------------------------------------------- accounts

section "Accounts and tools"

HOME_DIR=$(awk -F: '$1 == "user" { print $6 }' /etc/passwd 2>/dev/null)
if [ -n "$HOME_DIR" ]; then
    if [ -d "$HOME_DIR" ]; then
        ok "the user account has a home directory at $HOME_DIR"
    else
        warn "the user account points at $HOME_DIR, which does not exist" \
             "Logging in as user lands nowhere and the shipped /etc/skel is never applied."
    fi
fi

# Counted separately. Testing the global FAIL here would hide a healthy set of
# tools behind an unrelated failure earlier in the run.
MISSING_TOOLS=0
for t in pkg rsv systemctl font swap rezzconfig; do
    if [ ! -x "/usr/bin/$t" ]; then
        bad "/usr/bin/$t is missing or not executable"
        MISSING_TOOLS=$((MISSING_TOOLS + 1))
    fi
done
[ "$MISSING_TOOLS" -eq 0 ] && ok "the RezzOS tools are present and executable"

if [ -x /usr/bin/setconsolefont ]; then
    # With no arguments it prints usage and returns 1. A status of 126 or 127
    # means the kernel or the shell could not run it at all, which is what a
    # binary linked against a libc this image does not ship looks like.
    /usr/bin/setconsolefont >/dev/null 2>&1
    SCF_RC=$?
    if [ "$SCF_RC" -ge 126 ]; then
        warn "/usr/bin/setconsolefont will not run (exit $SCF_RC)" \
             "It is probably linked against a libc this image does not ship, so 'font set' cannot apply a font through the console ioctl."
    else
        ok "the console font helper runs"
    fi
fi

if [ -f /var/cache/pkg/APKINDEX_main ]; then
    ok "package indexes are present"
else
    warn "no package index cached" "Run 'pkg update' before installing anything."
fi

# --------------------------------------------------------------------- result

printf "\n${BOLD}%s ok, %s warnings, %s failures${NC}\n" "$PASS" "$WARN" "$FAIL"

if [ "$FAIL" -gt 0 ]; then
    exit 1
fi
exit 0
