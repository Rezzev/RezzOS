#!/bin/sh
CACHE_DIR="/var/cache/apk"
PKG_DIR="/mnt/disk/apk-packages"
INSTALLED_LIST="$PKG_DIR/installed.list"

# Decide where the list lives by whether the persistent disk is mounted, not by
# whether the package directory happens to exist yet.
#
# On a freshly formatted disk it does not exist: install_single_pkg creates it
# further down, on the first install. So the very first package of a new system
# had its .apk copied onto the disk while its name went into /var/log, which is
# initramfs, which is RAM. After a reboot init restored the package from
# packages/ but apk list no longer mentioned it and apk remove could not find
# it, for that one package, permanently.
#
# Creating the directory up front makes the two agree.
if grep -q ' /mnt/disk ' /proc/mounts 2>/dev/null; then
    mkdir -p "$PKG_DIR" 2>/dev/null
else
    INSTALLED_LIST="/var/log/apk-installed.list"
fi

ALPINE_VER="v3.20"
ARCH="x86_64"
REPO_MAIN="https://dl-cdn.alpinelinux.org/alpine/${ALPINE_VER}/main/${ARCH}"
REPO_COMMUNITY="https://dl-cdn.alpinelinux.org/alpine/${ALPINE_VER}/community/${ARCH}"

BLUE=$(printf '\033[0;34m')
GREEN=$(printf '\033[0;32m')
RED=$(printf '\033[0;31m')
YELLOW=$(printf '\033[1;33m')
NC=$(printf '\033[0m')

mkdir -p "$CACHE_DIR" /tmp/apk 2>/dev/null

usage() {
    echo -e "${BLUE}=== RezzOS Alpine Client (apk) ===${NC}"
    echo "Downloads packages directly from Alpine's real repositories."
    echo "Usage:"
    echo "  apk update                 - Refresh package indexes"
    echo "  apk install <package>      - Install package"
    echo "  apk upgrade                - Upgrade all installed packages"
    echo "  apk search <query>         - Search for packages"
    echo "  apk info <package>         - Show package details"
    echo "  apk list                   - List installed packages"
    echo "  apk remove <package>       - Remove package"
}

download_file() {
    URL="$1"
    OUTPUT="$2"

    # get full size from headers
    HEADERS=$(wget -S --spider "$URL" 2>&1)
    TOTAL=$(printf '%s\n' "$HEADERS" |
        awk 'tolower($1) == "content-length:" { n=$2 } END { print n+0 }')

    rm -f "$OUTPUT"

    # start the download
    wget --no-check-certificate "$URL" -O "$OUTPUT" >/dev/null 2>&1 &
    PID=$!

    BAR_WIDTH=30

    while kill -0 "$PID" 2>/dev/null; do
        if [ -f "$OUTPUT" ]; then
           CURRENT=$(wc -c < "$OUTPUT")
        else
            CURRENT=0
        fi

        if [ "$TOTAL" -gt 0 ]; then
            PERCENT=$((CURRENT * 100 / TOTAL))

            FILLED=$((PERCENT * BAR_WIDTH / 100))
            EMPTY=$((BAR_WIDTH - FILLED))

            BAR=""

            i=0
            while [ "$i" -lt "$FILLED" ]; do
                BAR="${BAR}="
                i=$((i + 1))
            done

            if [ "$FILLED" -lt "$BAR_WIDTH" ]; then
                BAR="${BAR}>"
                EMPTY=$((EMPTY - 1))
            fi

            while [ "$EMPTY" -gt 0 ]; do
                BAR="${BAR}-"
                EMPTY=$((EMPTY - 1))
            done

            printf '\r[%s] %3d%%' "$BAR" "$PERCENT"
        else
            printf '\rDownloaded: %s bytes' "$CURRENT"
        fi

        sleep 1
    done

    wait "$PID"
    RET=$?

    if [ -f "$OUTPUT" ]; then
        CURRENT=$(wc -c < "$OUTPUT")
    else
        CURRENT=0
    fi
    if [ "$RET" -eq 0 ] && [ "$CURRENT" -gt 0 ]; then
        if [ "$TOTAL" -gt 0 ]; then
            printf '\r[%s] 100%%\n' \
                "=============================="
        else
            printf '\rDownloaded: %s bytes\n' "$CURRENT"
        fi
        return 0
    fi

    printf '\n'
    rm -f "$OUTPUT"
    return 1
}

update_index() {
    echo "Fetching main index... "
    if download_file "$REPO_MAIN/APKINDEX.tar.gz" "$CACHE_DIR/APKINDEX_main.tar.gz"; then
        tar -xzf "$CACHE_DIR/APKINDEX_main.tar.gz" -C "$CACHE_DIR" 2>/dev/null
        mv "$CACHE_DIR/APKINDEX" "$CACHE_DIR/APKINDEX_main" 2>/dev/null
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}FAILED${NC}"
    fi

    echo "Fetching community index... "
    if download_file "$REPO_COMMUNITY/APKINDEX.tar.gz" "$CACHE_DIR/APKINDEX_community.tar.gz"; then
        tar -xzf "$CACHE_DIR/APKINDEX_community.tar.gz" -C "$CACHE_DIR" 2>/dev/null
        mv "$CACHE_DIR/APKINDEX" "$CACHE_DIR/APKINDEX_community" 2>/dev/null
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}FAILED${NC}"
    fi
}

search_pkg() {
    QUERY="$1"
    if test -z "$QUERY"; then
        echo -e "${RED}Specify something to search for.${NC}"
        return 1
    fi

    echo -e "${YELLOW}Searching for '$QUERY'...${NC}"

    RESULTS=$(
        for idx in "$CACHE_DIR/APKINDEX_main" "$CACHE_DIR/APKINDEX_community"; do
            test -f "$idx" || continue
            awk -v q="$QUERY" '
                function emit() {
                    if (name != "" && index(tolower(name), tolower(q)) > 0)
                        printf "%-34s %-20s %s\n", name, ver, desc
                    name = ""; ver = ""; desc = ""
                }
                /^P:/ { emit(); name = substr($0, 3); next }
                /^V:/ { ver  = substr($0, 3); next }
                /^T:/ { desc = substr($0, 3); next }
                END   { emit() }
            ' "$idx"
        done | sort -u
    )

    if test -z "$RESULTS"; then
        echo -e "${RED}No package matches '$QUERY'.${NC}"
        echo "Run 'apk update' first if you have not refreshed the indexes."
        return 1
    fi

    printf '%s\n' "$RESULTS"
    echo ""
    echo -e "${GREEN}$(printf '%s\n' "$RESULTS" | wc -l) package(s) found.${NC}"
}

info_pkg() {
    NAME="$1"
    if test -z "$NAME"; then
        echo -e "${RED}Specify a package.${NC}"
        return 1
    fi

    for idx in "$CACHE_DIR/APKINDEX_main" "$CACHE_DIR/APKINDEX_community"; do
        test -f "$idx" || continue
        REPO=$(basename "$idx" | sed 's/^APKINDEX_//')

        awk -v want="P:$NAME" -v repo="$REPO" '
            function human(b) {
                b = b + 0
                if (b <= 0)       return "unknown"
                if (b >= 1048576) return sprintf("%.1f MiB", b / 1048576)
                if (b >= 1024)    return sprintf("%.1f KiB", b / 1024)
                return b " B"
            }
            function show(label, value) {
                if (value != "") printf "  %-13s %s\n", label, value
            }
            $0 == want   { found = 1 }
            found && /^$/ { exit }
            found {
                key = substr($0, 1, 1)
                val = substr($0, 3)
                if      (key == "P") name  = val
                else if (key == "V") ver   = val
                else if (key == "T") desc  = val
                else if (key == "U") url   = val
                else if (key == "L") lic   = val
                else if (key == "A") arch  = val
                else if (key == "S") dl    = val
                else if (key == "I") inst  = val
                else if (key == "m") maint = val
                else if (key == "D") deps  = val
            }
            END {
                if (name == "") exit 1

                printf "\n  %s %s\n\n", name, ver
                show("Description:", desc)
                show("Repository:",  repo)
                show("Architecture:", arch)
                show("License:",     lic)
                show("Homepage:",    url)
                show("Maintainer:",  maint)
                show("Download:",    human(dl))
                show("Installed:",   human(inst))

                if (deps == "") {
                    printf "  %-13s none\n", "Depends on:"
                } else {
                    n = split(deps, d, " ")
                    line = ""
                    label = "Depends on:"
                    for (i = 1; i <= n; i++) {
                        if (length(line) + length(d[i]) + 1 > 62) {
                            printf "  %-13s %s\n", label, line
                            label = ""
                            line = ""
                        }
                        line = (line == "") ? d[i] : line " " d[i]
                    }
                    if (line != "") printf "  %-13s %s\n", label, line
                }
                printf "\n"
            }
        ' "$idx" && return 0
    done

    echo -e "${RED}No package named '$NAME'.${NC}"
    echo "Try 'apk search $NAME', or 'apk update' if the indexes are stale."
    return 1
}

find_pkg() {
    NAME="$1"
    for idx in "$CACHE_DIR/APKINDEX_main" "$CACHE_DIR/APKINDEX_community"; do
        test -f "$idx" || continue
        VER=$(grep -A1 "P:$NAME$" "$idx" | grep "^V:" | head -1 | sed 's/V://')
        if test -n "$VER"; then
            echo "${NAME}-${VER}.apk"
            return 0
        fi
    done
    return 1
}

get_deps() {
    NAME="$1"
    for idx in "$CACHE_DIR/APKINDEX_main" "$CACHE_DIR/APKINDEX_community"; do
        test -f "$idx" || continue

        grep -q "^P:$NAME$" "$idx" || continue

        DEPS=$(awk -v want="P:$NAME" '
            $0 == want { found = 1; next }
            found && /^$/ { exit }
            found && /^D:/ { sub(/^D:/, ""); print; exit }
        ' "$idx")

        for dep in $DEPS; do
            case "$dep" in
                so:*|cmd:*|pc:*|dbus:*|/bin/*|/sbin/*|/usr/*) continue ;;
            esac
            dep_name=$(echo "$dep" | sed 's/[<>=].*//')
            if echo "$dep_name" | grep -qE '^[a-zA-Z]' && ! echo "$dep_name" | grep -q '/'; then
                test "$dep_name" != "$NAME" && echo "$dep_name"
            fi
        done
        return 0
    done
    return 1
}

install_single_pkg() {
    PKG="$1"
    if echo "$PKG" | grep -q "\.apk$"; then
        APK="$PKG"
    else
        APK=$(find_pkg "$PKG")
    fi

    test -z "$APK" && echo -e "${RED}Not found: $PKG${NC}" && return 1

    echo -e "${YELLOW}Installing $APK...${NC}"
    mkdir -p "$PKG_DIR" /tmp/apk_dl

    download_file "$REPO_MAIN/$APK" "/tmp/apk_dl/$APK" || \
    download_file "$REPO_COMMUNITY/$APK" "/tmp/apk_dl/$APK"

    if test ! -s "/tmp/apk_dl/$APK"; then
        echo -e "${RED}Download failed for $APK${NC}"
        return 1
    fi

    cd /tmp || return 1

    TMP_DIR=$(mktemp -d /tmp/apk_extract.XXXXXX) || return 1

    cd "$TMP_DIR" || {
        rm -rf "$TMP_DIR"
        return 1
    }

    cleanup_tmp() {
        cd /tmp 2>/dev/null
        rm -rf "$TMP_DIR"
    }

    if ! tar -xzf "/tmp/apk_dl/$APK"; then
        echo -e "${RED}Failed to extract $APK${NC}"
        cleanup_tmp
        return 1
    fi

    if test -d usr && ! cp -r usr/. /usr/; then
        echo -e "${RED}Failed to install usr files from $APK${NC}"
        cleanup_tmp
        return 1
    fi

    if test -d lib && ! cp -r lib/. /lib/; then
        echo -e "${RED}Failed to install lib files from $APK${NC}"
        cleanup_tmp
        return 1
    fi

    if test -d bin && ! cp -r bin/. /bin/; then
        echo -e "${RED}Failed to install bin files from $APK${NC}"
        cleanup_tmp
        return 1
    fi

    if test -d sbin && ! cp -r sbin/. /sbin/; then
        echo -e "${RED}Failed to install sbin files from $APK${NC}"
        cleanup_tmp
        return 1
    fi

    if ! cp "/tmp/apk_dl/$APK" "$PKG_DIR/"; then
        echo -e "${RED}Failed to save $APK${NC}"
        cleanup_tmp
        return 1
    fi

    if ! echo "$APK" >> "$INSTALLED_LIST"; then
        echo -e "${RED}Failed to update installed package list${NC}"
        cleanup_tmp
        return 1
    fi

    echo -e "${GREEN}Done: $APK${NC}"

    cleanup_tmp
    return 0
}

install_with_deps() {
    PKG_NAME="$1"
    INSTALLED=""

    if ! find_pkg "$PKG_NAME" >/dev/null; then
        echo -e "${RED}Not found: $PKG_NAME${NC}"
        return 1
    fi

    install_deps_recursive() {
        local name="$1"
        local deps

        deps=$(get_deps "$name") || return 1

        for dep in $deps; do
            if echo "$INSTALLED" | grep -q " $dep "; then
                continue
            fi

            if grep -q "^${dep}-" "$INSTALLED_LIST" 2>/dev/null; then
                continue
            fi

            INSTALLED="$INSTALLED $dep "

            if ! install_deps_recursive "$dep"; then
                echo -e "${RED}Failed to resolve dependency: $dep${NC}"
                return 1
            fi

            echo "Installing dependency: $dep"

            if ! install_single_pkg "$dep"; then
                echo -e "${RED}Failed to install dependency: $dep${NC}"
                return 1
            fi
        done

        return 0
    }

    if ! install_deps_recursive "$PKG_NAME"; then
        echo -e "${RED}Failed to install dependencies for $PKG_NAME${NC}"
        return 1
    fi

    if ! install_single_pkg "$PKG_NAME"; then
        echo -e "${RED}Failed to install $PKG_NAME${NC}"
        return 1
    fi
}

upgrade_pkgs() {
    if test ! -s "$INSTALLED_LIST"; then
        echo "No packages"
        return 0
    fi

    if test ! -f "$CACHE_DIR/APKINDEX_main" && test ! -f "$CACHE_DIR/APKINDEX_community"; then
        echo -e "${RED}No package index. Run 'apk update' first.${NC}"
        return 1
    fi

    CHECKED=0
    UPGRADED=0
    FAILED=0

    for APK in $(sort -u "$INSTALLED_LIST"); do
        NAME=$(echo "$APK" | sed 's/-[^-]*-r[0-9][0-9]*\.apk$//')
        test -n "$NAME" || continue
        test "$NAME" != "$APK" || continue

        CHECKED=$((CHECKED + 1))

        LATEST=$(find_pkg "$NAME") || {
            echo -e "${YELLOW}Not in index, skipping: $NAME${NC}"
            continue
        }

        test "$LATEST" != "$APK" || continue

        echo -e "${YELLOW}$NAME: $APK -> $LATEST${NC}"

        if install_with_deps "$NAME"; then
            sed -i "/^${APK}$/d" "$INSTALLED_LIST" 2>/dev/null
            rm -f "$PKG_DIR/$APK"
            UPGRADED=$((UPGRADED + 1))
        else
            FAILED=$((FAILED + 1))
        fi
    done

    echo
    if test "$UPGRADED" -eq 0 && test "$FAILED" -eq 0; then
        echo -e "${GREEN}Everything is up to date ($CHECKED checked)${NC}"
    else
        echo -e "${GREEN}Checked $CHECKED, upgraded $UPGRADED, failed $FAILED${NC}"
    fi

    test "$FAILED" -eq 0
}

remove_pkg() {
    test -z "$1" && echo "Specify package" && return 1

    for PKG in "$@"; do
        if echo "$PKG" | grep -q "\.apk$"; then
            APK="$PKG"
        else
            APK=$(grep "^${PKG}-" "$INSTALLED_LIST" 2>/dev/null | head -1)
        fi

        if test -z "$APK"; then
            echo -e "${RED}Not installed: $PKG${NC}"
            continue
        fi

        APK_FILE="$PKG_DIR/$APK"
        if test ! -f "$APK_FILE"; then
            echo -e "${RED}Package file not found: $APK${NC}"
            sed -i "/^${APK}$/d" "$INSTALLED_LIST" 2>/dev/null
            continue
        fi

        echo -e "${YELLOW}Removing $APK...${NC}"

        KEPT="/tmp/apk_kept.$$"
        : > "$KEPT"
        for OTHER in $(sort -u "$INSTALLED_LIST" 2>/dev/null); do
            test "$OTHER" != "$APK" || continue
            test -f "$PKG_DIR/$OTHER" || continue
            tar -tzf "$PKG_DIR/$OTHER" 2>/dev/null | sed 's#^\./##' >> "$KEPT"
        done
        sort -u "$KEPT" -o "$KEPT" 2>/dev/null

        OWNED="/tmp/apk_owned.$$"
        tar -tzf "$APK_FILE" 2>/dev/null > "$OWNED"

        SHARED=0
        while IFS= read -r file; do
            file=${file#./}

            case "$file" in
                ""|.PKGINFO|.SIGN.*|.pre-*|.post-*|.trigger*) continue ;;
            esac

            target="/$file"
            test -f "$target" || test -L "$target" || continue

            if grep -qxF "$file" "$KEPT" 2>/dev/null; then
                SHARED=$((SHARED + 1))
                continue
            fi

            rm -f "$target"
        done < "$OWNED"

        rm -f "$KEPT" "$OWNED"

        if test "$SHARED" -gt 0; then
            echo -e "${YELLOW}Kept $SHARED file(s) still owned by other packages${NC}"
        fi

        rm -f "$APK_FILE"
        sed -i "/^${APK}$/d" "$INSTALLED_LIST" 2>/dev/null
        echo -e "${GREEN}Removed: $APK${NC}"
    done
}

CMD="$1"
case "$CMD" in
    update)  update_index ;;
    install) test -z "$2" && usage || { shift; for pkg in "$@"; do install_with_deps "$pkg"; done; } ;;
    upgrade) upgrade_pkgs ;;
    search)  search_pkg "$2" ;;
    info)    info_pkg "$2" ;;
    list)    cat "$INSTALLED_LIST" 2>/dev/null || echo "No packages" ;;
    remove)  test -z "$2" && echo "Specify package" || { shift; remove_pkg "$@"; } ;;
    *)       usage ;;
esac
