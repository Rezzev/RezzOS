#!/bin/sh
CACHE_DIR="/var/cache/pkg"
PKG_DIR="/mnt/disk/packages"
INSTALLED_LIST="$PKG_DIR/installed.list"

# Decide where the list lives by whether the persistent disk is mounted, not by
# whether the package directory happens to exist yet. See original comment:
# creating the directory up front makes disk-mounted vs RAM-fallback agree.
if grep -q ' /mnt/disk ' /proc/mounts 2>/dev/null; then
    mkdir -p "$PKG_DIR" 2>/dev/null
else
    INSTALLED_LIST="/var/log/installed.list"
fi

# --- Your repo, not Alpine's ---
REPO_INDEX="https://raw.githubusercontent.com/semen88pochuev-eng/RezzOS-Packages/main/index.txt"
INDEX="$CACHE_DIR/index.txt"
ARCH="x86_64"
CERT_BUNDLE="/etc/ssl/certs/ca-certificates.crt"

# Files that make up the base system itself. No package, ever, under any
# circumstances, is allowed to overwrite these through the normal install
# path — this is what got clobbered when a git package shipped its own copy
# of ld-musl and silently replaced the system's libc. Add paths here, not
# whole packages: it's specific files that are dangerous, not names.
PROTECTED_FILES="
/lib/ld-musl-x86_64.so.1
/bin/busybox
/sbin/busybox
/usr/bin/busybox
/sbin/init
/sbin/runit
/usr/sbin/runit
/bin/runit
/usr/bin/runsvdir
/sbin/runsvdir
"

is_protected() {
    f="$1"
    for p in $PROTECTED_FILES; do
        test "$f" = "$p" && return 0
    done
    return 1
}

BLUE=$(printf '\033[0;34m')
GREEN=$(printf '\033[0;32m')
RED=$(printf '\033[0;31m')
YELLOW=$(printf '\033[1;33m')
NC=$(printf '\033[0m')

mkdir -p "$CACHE_DIR" /tmp/pkg 2>/dev/null

usage() {
    echo -e "${BLUE}=== RezzOS Package Manager (apk) ===${NC}"
    echo "Usage:"
    echo "  apk update                 - Refresh package index"
    echo "  apk install <package>      - Install package"
    echo "  apk upgrade                - Upgrade all installed packages"
    echo "  apk search <query>         - Search for packages"
    echo "  apk info <package>         - Show package details"
    echo "  apk list                   - List installed packages"
    echo "  apk remove <package>       - Remove package"
    echo "  apk restore                - Re-place installed packages from cache (boot use)"
}

download_file() {
    URL="$1"
    OUTPUT="$2"

    if [ -f "$CERT_BUNDLE" ]; then
        SPIDER_TLS_OPTS=""
    else
        SPIDER_TLS_OPTS="--no-check-certificate"
    fi

    HEADERS=$(wget -S --spider $SPIDER_TLS_OPTS "$URL" 2>&1)
    TOTAL=$(printf '%s\n' "$HEADERS" |
        awk 'tolower($1) == "content-length:" { n=$2 } END { print n+0 }')

    rm -f "$OUTPUT"

    # Verify HTTPS certificates for real once the cert bundle exists.
    # Before that (e.g. installing ca-certificates itself for the first
    # time), there's nothing to verify against — fall back with a visible
    # warning instead of silently skipping verification forever.
    if [ -f "$CERT_BUNDLE" ]; then
        WGET_TLS_OPTS=""
    else
        echo -e "${YELLOW}Warning: no cert bundle at $CERT_BUNDLE yet, HTTPS not verified for this download${NC}"
        WGET_TLS_OPTS="--no-check-certificate"
    fi

    wget $WGET_TLS_OPTS "$URL" -O "$OUTPUT" >/dev/null 2>&1 &
    PID=$!

    BAR_WIDTH=30

    while kill -0 "$PID" 2>/dev/null; do
        if [ -f "$OUTPUT" ]; then
            CURRENT=$(wc -c < "$OUTPUT")
        else
            CURRENT=0
        fi

        if [ "$TOTAL" -gt 0 ]; then
            PERCENT=$((CURRENT * 100 / TOTAL))
            FILLED=$((PERCENT * BAR_WIDTH / 100))
            EMPTY=$((BAR_WIDTH - FILLED))
            BAR=""
            i=0
            while [ "$i" -lt "$FILLED" ]; do
                BAR="${BAR}="
                i=$((i + 1))
            done
            if [ "$FILLED" -lt "$BAR_WIDTH" ]; then
                BAR="${BAR}>"
                EMPTY=$((EMPTY - 1))
            fi
            while [ "$EMPTY" -gt 0 ]; do
                BAR="${BAR}-"
                EMPTY=$((EMPTY - 1))
            done
            printf '\r[%s] %3d%%' "$BAR" "$PERCENT"
        else
            printf '\rDownloaded: %s bytes' "$CURRENT"
        fi

        sleep 1
    done

    wait "$PID"
    RET=$?

    if [ -f "$OUTPUT" ]; then
        CURRENT=$(wc -c < "$OUTPUT")
    else
        CURRENT=0
    fi
    if [ "$RET" -eq 0 ] && [ "$CURRENT" -gt 0 ]; then
        if [ "$TOTAL" -gt 0 ]; then
            printf '\r[%s] 100%%\n' "=============================="
        else
            printf '\rDownloaded: %s bytes\n' "$CURRENT"
        fi
        return 0
    fi

    printf '\n'
    rm -f "$OUTPUT"
    return 1
}

update_index() {
    echo "Fetching index... "
    if download_file "$REPO_INDEX" "$INDEX"; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}FAILED${NC}"
        return 1
    fi
}

# Returns the last matching line for a package name, i.e. the newest entry
# appended to index.txt. Format: name|version|arch|url|sha256
get_pkg_line() {
    test -f "$INDEX" || return 1
    grep "^$1|" "$INDEX" | grep "|$ARCH|" | tail -1
}

search_pkg() {
    QUERY="$1"
    if test -z "$QUERY"; then
        echo -e "${RED}Specify something to search for.${NC}"
        return 1
    fi
    test -f "$INDEX" || { echo -e "${RED}No index. Run 'apk update' first.${NC}"; return 1; }

    echo -e "${YELLOW}Searching for '$QUERY'...${NC}"

    RESULTS=$(awk -F'|' -v q="$QUERY" '
        index(tolower($1), tolower(q)) > 0 {
            printf "%-20s %s\n", $1, $2
        }
    ' "$INDEX" | sort -u)

    if test -z "$RESULTS"; then
        echo -e "${RED}No package matches '$QUERY'.${NC}"
        return 1
    fi

    printf '%s\n' "$RESULTS"
    echo ""
    echo -e "${GREEN}$(printf '%s\n' "$RESULTS" | wc -l) package(s) found.${NC}"
}

info_pkg() {
    NAME="$1"
    if test -z "$NAME"; then
        echo -e "${RED}Specify a package.${NC}"
        return 1
    fi
    test -f "$INDEX" || { echo -e "${RED}No index. Run 'apk update' first.${NC}"; return 1; }

    LINE=$(get_pkg_line "$NAME")
    if test -z "$LINE"; then
        echo -e "${RED}No package named '$NAME'.${NC}"
        echo "Try 'apk search $NAME', or 'apk update' if the index is stale."
        return 1
    fi

    VER=$(echo "$LINE" | cut -d'|' -f2)
    PARCH=$(echo "$LINE" | cut -d'|' -f3)
    URL=$(echo "$LINE" | cut -d'|' -f4)
    SHA=$(echo "$LINE" | cut -d'|' -f5)

    printf "\n  %s %s\n\n" "$NAME" "$VER"
    printf "  %-13s %s\n" "Architecture:" "$PARCH"
    printf "  %-13s %s\n" "Source:" "$URL"
    printf "  %-13s %s\n" "SHA256:" "$SHA"
    printf "\n"
}

# Extracts $1 (a local .tar.gz already on disk) and places its files onto
# the root filesystem for package $2, respecting PROTECTED_FILES and file
# ownership. Shared by install_single_pkg (fresh install/upgrade) and
# restore_installed (boot-time re-placement from the cache disk).
place_package_files() {
    ARCHIVE="$1"
    NAME="$2"

    TMP_DIR=$(mktemp -d /tmp/pkg_extract.XXXXXX) || return 1
    cleanup_tmp() {
        cd /tmp 2>/dev/null
        rm -rf "$TMP_DIR"
    }
    cd "$TMP_DIR" || { rm -rf "$TMP_DIR"; return 1; }

    if ! tar -xzf "$ARCHIVE"; then
        echo -e "${RED}Failed to extract $(basename "$ARCHIVE")${NC}"
        cleanup_tmp
        return 1
    fi

    OWN_FILES="/tmp/pkg_ownfiles.$$"
    : > "$OWN_FILES"
    OLD_ENTRY=$(grep "^${NAME}|" "$INSTALLED_LIST" 2>/dev/null | head -1)
    if test -n "$OLD_ENTRY"; then
        OLD_FILE_ARCHIVE=$(echo "$OLD_ENTRY" | cut -d'|' -f3)
        if test -f "$PKG_DIR/$OLD_FILE_ARCHIVE"; then
            tar -tzf "$PKG_DIR/$OLD_FILE_ARCHIVE" 2>/dev/null | sed 's#^\./##' > "$OWN_FILES"
        fi
    fi

    SKIPPED=0
    INSTALL_FAILED=0
    FILE_LIST="/tmp/pkg_filelist.$$"
    (cd "$TMP_DIR" && find . -type f ! -name '.PKGINFO' -o -type l ! -name '.PKGINFO') | sed 's#^\./##' > "$FILE_LIST"

    while IFS= read -r rel; do
        test -n "$rel" || continue
        target="/$rel"
        src="$TMP_DIR/$rel"

        if is_protected "$target"; then
            echo -e "${YELLOW}Skipped (protected system file): $target${NC}"
            SKIPPED=$((SKIPPED + 1))
            continue
        fi

        if test -e "$target" || test -L "$target"; then
            if ! grep -qxF "$rel" "$OWN_FILES" 2>/dev/null; then
                echo -e "${YELLOW}Skipped (already provided by another package or the base system): $target${NC}"
                SKIPPED=$((SKIPPED + 1))
                continue
            fi
        fi

        mkdir -p "$(dirname "$target")" 2>/dev/null
        if ! cp -a "$src" "$target"; then
            echo -e "${RED}Failed to write $target${NC}"
            INSTALL_FAILED=1
        else
            # Free the temp copy immediately — for a package with hundreds
            # of MB of extracted files (webkit, icu...), holding both the
            # extracted tree and the placed copy at once can blow past a
            # capped root filesystem even when the archive itself is small
            # after compression.
            rm -f "$src"
        fi
    done < "$FILE_LIST"

    rm -f "$OWN_FILES" "$FILE_LIST"

    if test "$SKIPPED" -gt 0; then
        echo -e "${YELLOW}$SKIPPED file(s) skipped to avoid overwriting existing files${NC}"
    fi

    cleanup_tmp

    test "$INSTALL_FAILED" -eq 0
}

install_single_pkg() {
    NAME="$1"
    LINE=$(get_pkg_line "$NAME")

    test -z "$LINE" && echo -e "${RED}Not found: $NAME${NC}" && return 1

    VER=$(echo "$LINE" | cut -d'|' -f2)
    URL=$(echo "$LINE" | cut -d'|' -f4)
    SHA=$(echo "$LINE" | cut -d'|' -f5)
    FILE=$(basename "$URL")

    echo -e "${YELLOW}Installing $NAME $VER...${NC}"
    mkdir -p "$PKG_DIR" /tmp/pkg_dl

    if ! download_file "$URL" "/tmp/pkg_dl/$FILE"; then
        echo -e "${RED}Download failed for $NAME${NC}"
        return 1
    fi

    # Verify integrity/authenticity before touching anything on disk.
    ACTUAL_SHA=$(sha256sum "/tmp/pkg_dl/$FILE" | cut -d' ' -f1)
    if [ "$ACTUAL_SHA" != "$SHA" ]; then
        echo -e "${RED}SHA256 mismatch for $NAME! Expected $SHA, got $ACTUAL_SHA${NC}"
        rm -f "/tmp/pkg_dl/$FILE"
        return 1
    fi

    mkdir -p "$PKG_DIR"
    # Move the archive onto persistent storage before extracting. If
    # /mnt/disk is a real mount (not the capped RAM root), this frees up
    # rootfs space right away instead of holding the compressed archive
    # there for the whole install — matters a lot for large packages.
    if ! mv "/tmp/pkg_dl/$FILE" "$PKG_DIR/$FILE"; then
        echo -e "${RED}Failed to save $FILE${NC}"
        return 1
    fi

    if ! place_package_files "$PKG_DIR/$FILE" "$NAME"; then
        echo -e "${RED}Some files from $FILE failed to install${NC}"
        return 1
    fi

    # installed.list format: name|version|filename|sha256
    sed -i "/^${NAME}|/d" "$INSTALLED_LIST" 2>/dev/null
    if ! echo "${NAME}|${VER}|${FILE}|${SHA}" >> "$INSTALLED_LIST"; then
        echo -e "${RED}Failed to update installed package list${NC}"
        return 1
    fi

    echo -e "${GREEN}Done: $NAME $VER${NC}"
    return 0
}

# Re-places every installed package's files from the already-downloaded
# archive on $PKG_DIR, without touching the network. Meant to run once at
# boot, after /mnt/disk is mounted and before anything that depends on the
# installed packages starts — the RAM root comes up empty every time, so
# whatever isn't part of the base image has to be put back explicitly.
restore_installed() {
    if test ! -s "$INSTALLED_LIST"; then
        echo "No packages to restore"
        return 0
    fi

    OK=0
    FAILED=0

    while IFS='|' read -r NAME VER FILE SHA; do
        test -n "$NAME" || continue
        ARCHIVE="$PKG_DIR/$FILE"

        if test ! -f "$ARCHIVE"; then
            echo -e "${RED}Missing cached archive for $NAME, skipping: $ARCHIVE${NC}"
            FAILED=$((FAILED + 1))
            continue
        fi

        if test -n "$SHA"; then
            ACTUAL_SHA=$(sha256sum "$ARCHIVE" | cut -d' ' -f1)
            if [ "$ACTUAL_SHA" != "$SHA" ]; then
                echo -e "${RED}SHA256 mismatch for cached $NAME, skipping${NC}"
                FAILED=$((FAILED + 1))
                continue
            fi
        fi

        if place_package_files "$ARCHIVE" "$NAME"; then
            echo -e "${GREEN}Restored: $NAME $VER${NC}"
            OK=$((OK + 1))
        else
            echo -e "${RED}Failed to restore: $NAME${NC}"
            FAILED=$((FAILED + 1))
        fi
    done < "$INSTALLED_LIST"

    echo -e "${GREEN}Restored $OK, failed $FAILED${NC}"
    test "$FAILED" -eq 0
}

upgrade_pkgs() {
    if test ! -s "$INSTALLED_LIST"; then
        echo "No packages"
        return 0
    fi
    if test ! -f "$INDEX"; then
        echo -e "${RED}No package index. Run 'apk update' first.${NC}"
        return 1
    fi

    CHECKED=0
    UPGRADED=0
    FAILED=0

    while IFS='|' read -r NAME VER FILE SHA; do
        test -n "$NAME" || continue
        CHECKED=$((CHECKED + 1))

        LINE=$(get_pkg_line "$NAME")
        if test -z "$LINE"; then
            echo -e "${YELLOW}Not in index, skipping: $NAME${NC}"
            continue
        fi

        LATEST_VER=$(echo "$LINE" | cut -d'|' -f2)
        test "$LATEST_VER" = "$VER" && continue

        echo -e "${YELLOW}$NAME: $VER -> $LATEST_VER${NC}"

        OLD_FILE="$FILE"
        if install_single_pkg "$NAME"; then
            rm -f "$PKG_DIR/$OLD_FILE"
            UPGRADED=$((UPGRADED + 1))
        else
            FAILED=$((FAILED + 1))
        fi
    done < "$INSTALLED_LIST"

    echo
    if test "$UPGRADED" -eq 0 && test "$FAILED" -eq 0; then
        echo -e "${GREEN}Everything is up to date ($CHECKED checked)${NC}"
    else
        echo -e "${GREEN}Checked $CHECKED, upgraded $UPGRADED, failed $FAILED${NC}"
    fi

    test "$FAILED" -eq 0
}

remove_pkg() {
    test -z "$1" && echo "Specify package" && return 1

    for NAME in "$@"; do
        ENTRY=$(grep "^${NAME}|" "$INSTALLED_LIST" 2>/dev/null | head -1)
        if test -z "$ENTRY"; then
            echo -e "${RED}Not installed: $NAME${NC}"
            continue
        fi

        FILE=$(echo "$ENTRY" | cut -d'|' -f3)
        APK_FILE="$PKG_DIR/$FILE"

        if test ! -f "$APK_FILE"; then
            echo -e "${RED}Package file not found: $FILE${NC}"
            sed -i "/^${NAME}|/d" "$INSTALLED_LIST" 2>/dev/null
            continue
        fi

        echo -e "${YELLOW}Removing $NAME...${NC}"

        # Collect every path owned by other installed packages so shared
        # files aren't pulled out from under something still installed.
        KEPT="/tmp/pkg_kept.$$"
        : > "$KEPT"
        while IFS='|' read -r ONAME OVER OFILE OSHA; do
            test "$ONAME" != "$NAME" || continue
            test -f "$PKG_DIR/$OFILE" || continue
            tar -tzf "$PKG_DIR/$OFILE" 2>/dev/null | sed 's#^\./##' >> "$KEPT"
        done < "$INSTALLED_LIST"
        sort -u "$KEPT" -o "$KEPT" 2>/dev/null

        OWNED="/tmp/pkg_owned.$$"
        tar -tzf "$APK_FILE" 2>/dev/null > "$OWNED"

        SHARED=0
        while IFS= read -r file; do
            file=${file#./}
            case "$file" in
                ""|.PKGINFO) continue ;;
            esac

            target="/$file"
            test -f "$target" || test -L "$target" || continue

            if grep -qxF "$file" "$KEPT" 2>/dev/null; then
                SHARED=$((SHARED + 1))
                continue
            fi

            rm -f "$target"
        done < "$OWNED"

        rm -f "$KEPT" "$OWNED"

        if test "$SHARED" -gt 0; then
            echo -e "${YELLOW}Kept $SHARED file(s) still owned by other packages${NC}"
        fi

        rm -f "$APK_FILE"
        sed -i "/^${NAME}|/d" "$INSTALLED_LIST" 2>/dev/null
        echo -e "${GREEN}Removed: $NAME${NC}"
    done
}

list_pkgs() {
    if test ! -s "$INSTALLED_LIST"; then
        echo "No packages"
        return 0
    fi
    awk -F'|' '{ printf "%-20s %s\n", $1, $2 }' "$INSTALLED_LIST"
}

CMD="$1"
case "$CMD" in
    update)  update_index ;;
    install) test -z "$2" && usage || { shift; for pkg in "$@"; do install_single_pkg "$pkg"; done; } ;;
    upgrade) upgrade_pkgs ;;
    search)  search_pkg "$2" ;;
    info)    info_pkg "$2" ;;
    list)    list_pkgs ;;
    remove)  test -z "$2" && echo "Specify package" || { shift; remove_pkg "$@"; } ;;
    restore) restore_installed ;;
    *)       usage ;;
esac
