#!/bin/bash

BLUE=$(printf '\033[1;34m')
WHITE=$(printf '\033[1;37m')
CYAN=$(printf '\033[1;36m')
NC=$(printf '\033[0m')

OS="RezzOS"
KERNEL=$(uname -r)
ARCH=$(uname -m)
UPTIME=$(awk '{print int($1/3600)"h "int(($1%3600)/60)"m"}' /proc/uptime)
CPU=$(awk -F': ' '/model name/ {print $2; exit}' /proc/cpuinfo | sed 's/  */ /g')
[ -z "$CPU" ] && CPU="Unknown CPU"

MEM_TOTAL=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
MEM_FREE=$(awk '/MemFree/ {print $2}' /proc/meminfo)
if [ -n "$MEM_TOTAL" ] && [ -n "$MEM_FREE" ]; then
    MEM_USED=$(( (MEM_TOTAL - MEM_FREE) / 1024 ))
    MEM_TOTAL=$(( MEM_TOTAL / 1024 ))
    MEMORY="${MEM_USED}MB / ${MEM_TOTAL}MB"
else
    MEMORY="Unknown"
fi



info() {
	echo -e "${BLUE}_______________________________________________________________________${NC}"
	echo -e "${CYAN}OS:${NC} $OS													 "
	echo -e "${CYAN}ARCH:${NC} $ARCH											 "
	echo -e "${CYAN}UPTIME:${NC} $UPTIME										 "
	echo -e "${CYAN}KERNEL:${NC} $KERNEL										 "
	echo -e "${CYAN}CPU:${NC} $CPU												 "
	echo -e "${CYAN}MEMORY:${NC} $MEMORY										 "										
	echo -e "${BLUE}_______________________________________________________________________${NC}"




	
}



info
