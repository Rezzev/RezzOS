#!/bin/sh
BLUE=$(printf '\033[1;34m')
CYAN=$(printf '\033[1;36m')
NC=$(printf '\033[0m')

echo "${BLUE}=== RezzOS Help ===${NC}"
echo ""
echo "${CYAN}System Setup & Installation:${NC}"
echo "  rezzinstall              - Interactive installer to install RezzOS onto disk/SSD/USB"
echo "  rezzconfig / config      - Interactive system control center & TUI menu"
echo "  rezzkeymap [set|current] - Keyboard layout manager (RU/EN, toggle hotkeys)"
echo "  rezzuser [add|del|list]  - User account & password manager"
echo "  font [set|list|current]  - Console font switcher (e.g. font set TER16x32)"
echo ""
echo "${CYAN}System Info & Diagnostics:${NC}"
echo "  rezzfetch                - Show system information logo and specs"
echo "  rezzhw [all|cpu|mem|...] - Hardware diagnostics utility"
echo "  rezzdoctor               - Check system health and persistent storage"
echo "  swap [create|on|off]     - Manage swap memory file"
echo ""
echo "${CYAN}Power & System Control:${NC}"
echo "  poweroff / halt          - Power off the system cleanly"
echo "  reboot                   - Reboot the system cleanly"
echo "  suspend                  - Suspend system (freeze & wait for Enter to wake)"
echo "  hibernate                - Save memory to swap & power off (requires swap)"
echo "  shutdown [-h|-r|-s|-z]   - Multi-purpose system shutdown utility"
echo ""
echo "${CYAN}Text Editors:${NC}"
echo "  nano <file> / notepad    - User-friendly GNU Nano text editor"
echo "  vi <file> / neatvi       - Classic Vi text editor"
echo ""
echo "${CYAN}Package Manager:${NC}"
echo "  pkg update               - Refresh package indexes from Alpine repos"
echo "  pkg install <package>    - Install package with dependencies"
echo "  pkg search <query>       - Search available packages"
echo "  pkg info <package>       - View detailed package info"
echo "  pkg remove <package>     - Remove installed package"
echo "  pkg list                 - List installed packages"
echo ""
echo "${CYAN}Terminal & Command Navigation:${NC}"
echo "  Up / Down Arrows        - Recall previous/next commands"
echo "  Shift+PgUp / PgDn       - Scroll terminal history buffer"
echo "  Mouse Wheel             - Scroll terminal up/down"
echo ""
