#!/bin/sh
# RezzOS Interactive Control Center (rezzconfig)
# Copyright (c) RezzOS Project

CYAN=$(printf '\033[1;36m')
GREEN=$(printf '\033[1;32m')
YELLOW=$(printf '\033[1;33m')
RED=$(printf '\033[1;31m')
BLUE=$(printf '\033[1;34m')
MAGENTA=$(printf '\033[1;35m')
BOLD=$(printf '\033[1m')
NC=$(printf '\033[0m')

header() {
    clear
    echo -e "${CYAN}======================================================${NC}"
    echo -e "${BOLD}${MAGENTA}       RezzOS Control Center (rezzconfig) v1.0        ${NC}"
    echo -e "${CYAN}======================================================${NC}"
    
    HN=$(hostname 2>/dev/null || echo "rezzos")
    IP=$(ip route get 1 2>/dev/null | awk '{print $7; exit}')
    [ -z "$IP" ] && IP=$(ifconfig eth0 2>/dev/null | grep 'inet addr' | cut -d: -f2 | awk '{print $1}')
    [ -z "$IP" ] && IP="No Network"
    
    CFONT="Default"
    if [ -f /etc/font.conf ]; then
        CFONT=$(grep -o 'FONT=[^ ]*' /etc/font.conf 2>/dev/null | cut -d= -f2)
    fi
    [ -z "$CFONT" ] && CFONT="TER16x32"

    SWAP_INFO=$(free -m 2>/dev/null | grep -i Swap | awk '{if ($2>0) print $3"M/"$2"M"; else print "Disabled"}')

    echo -e " Host: ${GREEN}$HN${NC} | IP: ${GREEN}$IP${NC} | Font: ${GREEN}$CFONT${NC} | Swap: ${GREEN}$SWAP_INFO${NC}"
    echo -e "${CYAN}------------------------------------------------------${NC}"
    echo ""
}

pause() {
    echo ""
    echo -e "${YELLOW}Press [ENTER] to return to menu...${NC}"
    read -r _
}

net_menu() {
    while true; do
        header
        echo -e "${BOLD}--- Network Configuration ---${NC}"
        echo "1) View Current Network Status"
        echo "2) Auto-Configure Network (DHCP)"
        echo "3) Configure Static IP"
        echo "4) Set DNS Server"
        echo "5) Test Network Connectivity (Ping)"
        echo "0) Back to Main Menu"
        echo ""
        echo -n "Select option [0-5]: "
        read -r choice

        case "$choice" in
            1)
                echo -e "\n${CYAN}--- Network Interfaces ---${NC}"
                ifconfig 2>/dev/null || ip addr show
                echo -e "\n${CYAN}--- Routing Table ---${NC}"
                route -n 2>/dev/null || ip route
                echo -e "\n${CYAN}--- DNS Servers (/etc/resolv.conf) ---${NC}"
                cat /etc/resolv.conf 2>/dev/null
                pause
                ;;
            2)
                echo -e "\n${YELLOW}Requesting IP via DHCP on eth0...${NC}"
                ifconfig eth0 up 2>/dev/null
                if udhcpc -b -i eth0 -s /usr/share/udhcpc/default.script 2>/dev/null; then
                    echo -e "${GREEN}DHCP Configuration completed successfully!${NC}"
                else
                    echo -e "${RED}DHCP failed or eth0 not available.${NC}"
                fi
                pause
                ;;
            3)
                echo -e "\n${CYAN}--- Static IP Setup ---${NC}"
                echo -n "Enter Interface [eth0]: "
                read -r IFACE
                [ -z "$IFACE" ] && IFACE="eth0"

                echo -n "Enter IP Address (e.g. 192.168.1.100): "
                read -r IPADDR
                echo -n "Enter Subnet Mask [255.255.255.0]: "
                read -r MASK
                [ -z "$MASK" ] && MASK="255.255.255.0"

                echo -n "Enter Gateway [192.168.1.1]: "
                read -r GW

                if [ -n "$IPADDR" ]; then
                    ifconfig "$IFACE" "$IPADDR" netmask "$MASK" up
                    [ -n "$GW" ] && route add default gw "$GW" 2>/dev/null
                    echo -e "${GREEN}Network interface $IFACE set to $IPADDR${NC}"
                else
                    echo -e "${RED}Invalid IP address specified.${NC}"
                fi
                pause
                ;;
            4)
                echo -e "\n${CYAN}--- Set DNS Nameserver ---${NC}"
                echo -n "Enter Primary DNS [8.8.8.8]: "
                read -r DNS1
                [ -z "$DNS1" ] && DNS1="8.8.8.8"
                echo "nameserver $DNS1" > /etc/resolv.conf
                echo -e "${GREEN}DNS updated to $DNS1${NC}"
                pause
                ;;
            5)
                echo -e "\n${YELLOW}Pinging 8.8.8.8 (4 packets)...${NC}"
                ping -c 4 8.8.8.8
                pause
                ;;
            0) break ;;
        esac
    done
}

hostname_menu() {
    header
    echo -e "${BOLD}--- Hostname & System Info ---${NC}"
    CUR_HN=$(hostname)
    echo -e "Current Hostname: ${GREEN}$CUR_HN${NC}"
    echo ""
    echo -n "Enter new hostname (leave blank to cancel): "
    read -r NEW_HN

    if [ -n "$NEW_HN" ]; then
        hostname "$NEW_HN"
        echo "$NEW_HN" > /etc/hostname
        if [ -d /mnt/disk ]; then
            echo "$NEW_HN" > /mnt/disk/etc/hostname 2>/dev/null || true
        fi
        echo -e "${GREEN}Hostname changed to '$NEW_HN' successfully!${NC}"
    fi
    pause
}

font_menu() {
    header
    echo -e "${BOLD}--- Console Font Selection ---${NC}"
    if command -v font >/dev/null 2>&1; then
        font list
    fi
    echo ""
    echo -n "Enter font name to set (e.g. SUN12x22, TER16x32) or blank to exit: "
    read -r FONTNAME

    if [ -n "$FONTNAME" ]; then
        font set "$FONTNAME"
    fi
    pause
}

swap_menu() {
    while true; do
        header
        echo -e "${BOLD}--- Swap Memory Manager ---${NC}"
        echo "1) View Swap Status"
        echo "2) Create & Enable Swap File (256MB)"
        echo "3) Create & Enable Swap File (512MB)"
        echo "4) Create & Enable Swap File (1024MB)"
        echo "5) Turn Off Swap"
        echo "0) Back to Main Menu"
        echo ""
        echo -n "Select option [0-5]: "
        read -r choice

        case "$choice" in
            1)
                echo ""
                if command -v swap >/dev/null 2>&1; then
                    swap status
                else
                    free -m
                fi
                pause
                ;;
            2)
                swap create 256M
                pause
                ;;
            3)
                swap create 512M
                pause
                ;;
            4)
                swap create 1024M
                pause
                ;;
            5)
                swap off 2>/dev/null || swapoff -a 2>/dev/null
                echo -e "${GREEN}Swap disabled.${NC}"
                pause
                ;;
            0) break ;;
        esac
    done
}

service_menu() {
    while true; do
        header
        echo -e "${BOLD}--- Runit Services Manager ---${NC}"
        echo "1) List Services Status"
        echo "2) Start Service"
        echo "3) Stop Service"
        echo "4) Restart Service"
        echo "0) Back to Main Menu"
        echo ""
        echo -n "Select option [0-4]: "
        read -r choice

        case "$choice" in
            1)
                echo ""
                rsv list
                pause
                ;;
            2)
                echo -n "Enter service name to start: "
                read -r SVNAME
                [ -n "$SVNAME" ] && rsv up "$SVNAME"
                pause
                ;;
            3)
                echo -n "Enter service name to stop: "
                read -r SVNAME
                [ -n "$SVNAME" ] && rsv down "$SVNAME"
                pause
                ;;
            4)
                echo -n "Enter service name to restart: "
                read -r SVNAME
                [ -n "$SVNAME" ] && rsv restart "$SVNAME"
                pause
                ;;
            0) break ;;
        esac
    done
}

user_menu() {
    while true; do
        header
        echo -e "${BOLD}--- User & Password Management ---${NC}"
        echo "1) Change Root Password"
        echo "2) Change User Password"
        echo "3) Add New User"
        echo "0) Back to Main Menu"
        echo ""
        echo -n "Select option [0-3]: "
        read -r choice

        case "$choice" in
            1)
                passwd root
                pause
                ;;
            2)
                passwd user 2>/dev/null || passwd
                pause
                ;;
            3)
                echo -n "Enter new username: "
                read -r NEWUSER
                if [ -n "$NEWUSER" ]; then
                    adduser "$NEWUSER"
                fi
                pause
                ;;
            0) break ;;
        esac
    done
}

pkg_menu() {
    while true; do
        header
        echo -e "${BOLD}--- Package Quick Actions (pkg) ---${NC}"
        echo "1) Update Package Indexes"
        echo "2) Search for Package"
        echo "3) Install Package"
        echo "4) List Installed Packages"
        echo "0) Back to Main Menu"
        echo ""
        echo -n "Select option [0-4]: "
        read -r choice

        case "$choice" in
            1)
                pkg update
                pause
                ;;
            2)
                echo -n "Enter search query: "
                read -r Q
                [ -n "$Q" ] && pkg search "$Q"
                pause
                ;;
            3)
                echo -n "Enter package name: "
                read -r P
                [ -n "$P" ] && pkg install "$P"
                pause
                ;;
            4)
                pkg list
                pause
                ;;
            0) break ;;
        esac
    done
}

while true; do
    header
    echo " 1) 🌐 Network Configuration (DHCP / Static IP / DNS)"
    echo " 2) 🏷️ Hostname & System Info"
    echo " 3) 🔤 Console Font Selection"
    echo " 4) 💾 Swap Storage Manager"
    echo " 5) ⚙️ Services Manager (runit)"
    echo " 6) 👤 User & Password Management"
    echo " 7) 📦 Package Quick Actions (pkg)"
    echo " 8) 📊 Launch System Resource Monitor (rezzmon)"
    echo " 9) ⚡ Power Options (Reboot / Shutdown)"
    echo " 0) ❌ Exit Control Center"
    echo ""
    echo -n "Select an option [0-9]: "
    read -r MAIN_CHOICE

    case "$MAIN_CHOICE" in
        1) net_menu ;;
        2) hostname_menu ;;
        3) font_menu ;;
        4) swap_menu ;;
        5) service_menu ;;
        6) user_menu ;;
        7) pkg_menu ;;
        8) rezzmon watch 2>/dev/null || rezzmon ;;
        9)
            header
            echo -e "${BOLD}--- Power Control ---${NC}"
            echo "1) Reboot System"
            echo "2) Power Off System"
            echo "0) Cancel"
            echo -n "Select option [0-2]: "
            read -r PCHOICE
            case "$PCHOICE" in
                1) reboot ;;
                2) poweroff ;;
                *) ;;
            esac
            ;;
        0|exit|q)
            clear
            echo -e "${GREEN}Exited RezzOS Control Center.${NC}"
            exit 0
            ;;
        *)
            echo -e "${RED}Invalid option!${NC}"
            sleep 1
            ;;
    esac
done
