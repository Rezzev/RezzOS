#!/bin/sh
# RezzOS Keyboard & Layout Manager (rezzkeymap)
# Copyright (c) RezzOS Project

CONF_FILE="/etc/keymap.conf"
DISK_CONF="/mnt/disk/etc/keymap.conf"

RED=$(printf '\033[1;31m')
GREEN=$(printf '\033[1;32m')
YELLOW=$(printf '\033[1;33m')
CYAN=$(printf '\033[1;36m')
BOLD=$(printf '\033[1m')
NC=$(printf '\033[0m')

load_conf() {
    LAYOUT="us,ru"
    TOGGLE="grp:alt_shift_toggle,grp_led:scroll"
    if [ -f "$CONF_FILE" ]; then
        . "$CONF_FILE"
    elif [ -f "$DISK_CONF" ]; then
        . "$DISK_CONF"
    fi
}

apply_keymap() {
    local lay="$1"
    local opt="$2"

    [ -z "$lay" ] && lay="us,ru"
    [ -z "$opt" ] && opt="grp:alt_shift_toggle,grp_led:scroll"

    # Apply in X11 session if running
    if [ -n "$DISPLAY" ] && command -v setxkbmap >/dev/null 2>&1; then
        if [ -n "$opt" ]; then
            setxkbmap -layout "$lay" -option "$opt" 2>/dev/null || setxkbmap -layout "$lay" 2>/dev/null || true
        else
            setxkbmap -layout "$lay" -option "" 2>/dev/null || true
        fi
    fi

    # Save to /etc/keymap.conf
    cat > "$CONF_FILE" << EOF
LAYOUT="$lay"
TOGGLE="$opt"
EOF

    # Save to persistent storage if available
    if grep -q ' /mnt/disk ' /proc/mounts 2>/dev/null; then
        mkdir -p /mnt/disk/etc 2>/dev/null || true
        cp -f "$CONF_FILE" "$DISK_CONF" 2>/dev/null || true
    fi

    echo -e "${GREEN}Keyboard layout set to:${NC} $lay"
    [ -n "$opt" ] && echo -e "${GREEN}Switch shortcut:${NC} $opt"
}

show_current() {
    load_conf
    echo -e "${CYAN}=== Current Keyboard Layout ===${NC}"
    echo -e "  Layout:   ${GREEN}$LAYOUT${NC}"
    echo -e "  Shortcut: ${GREEN}$TOGGLE${NC}"
}

interactive_menu() {
    load_conf
    clear
    echo -e "${CYAN}======================================================${NC}"
    echo -e "${BOLD}       RezzOS Keyboard & Layout Configuration         ${NC}"
    echo -e "${CYAN}======================================================${NC}"
    echo -e "Current layout: ${GREEN}$LAYOUT${NC} (Shortcut: ${GREEN}$TOGGLE${NC})"
    echo ""
    echo "Presets:"
    echo "  1) US / RU — Toggle: Alt + Shift [Default]"
    echo "  2) US / RU — Toggle: Caps Lock"
    echo "  3) US / RU — Toggle: Ctrl + Shift"
    echo "  4) US / RU — Toggle: Right Alt (AltGr)"
    echo "  5) US English only"
    echo "  6) Custom layout string"
    echo "  0) Exit"
    echo ""
    printf "Choose option [0-6]: "
    read -r choice

    case "$choice" in
        1) apply_keymap "us,ru" "grp:alt_shift_toggle,grp_led:scroll" ;;
        2) apply_keymap "us,ru" "grp:caps_toggle,grp_led:scroll" ;;
        3) apply_keymap "us,ru" "grp:ctrl_shift_toggle,grp_led:scroll" ;;
        4) apply_keymap "us,ru" "grp:r_alt_toggle,grp_led:scroll" ;;
        5) apply_keymap "us" "" ;;
        6)
            printf "Enter layout (e.g. us,ru,de): "
            read -r custom_lay
            printf "Enter toggle option (e.g. grp:alt_shift_toggle): "
            read -r custom_opt
            apply_keymap "$custom_lay" "$custom_opt"
            ;;
        *) echo "No changes made." ;;
    esac
}

usage() {
    echo "Usage:"
    echo "  rezzkeymap                        - Interactive menu"
    echo "  rezzkeymap current                - Show current layout"
    echo "  rezzkeymap set <layout> [toggle]  - Set layout (e.g. 'us,ru' 'grp:alt_shift_toggle')"
    echo "  rezzkeymap ru                     - Shortcut for US/RU (Alt+Shift)"
    echo "  rezzkeymap us                     - Shortcut for US English only"
}

case "$1" in
    current|status)
        show_current
        ;;
    set)
        apply_keymap "$2" "$3"
        ;;
    ru)
        apply_keymap "us,ru" "grp:alt_shift_toggle,grp_led:scroll"
        ;;
    us)
        apply_keymap "us" ""
        ;;
    help|-h|--help)
        usage
        ;;
    "")
        interactive_menu
        ;;
    *)
        echo -e "${RED}Unknown command '$1'${NC}"
        usage
        exit 1
        ;;
esac
