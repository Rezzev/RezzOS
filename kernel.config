#
# Ultra-minimal но десктоп-готовый конфиг Linux/x86 6.6.40
# Цель: musl-based дистрибутив с широкой аппаратной поддержкой
#
CONFIG_CC_VERSION_TEXT="gcc (GCC) 16.1.1 20260625"
CONFIG_CC_IS_GCC=y
CONFIG_GCC_VERSION=160101
CONFIG_CLANG_VERSION=0
CONFIG_AS_IS_GNU=y
CONFIG_AS_VERSION=24601
CONFIG_LD_IS_BFD=y
CONFIG_LD_VERSION=24601
CONFIG_LLD_VERSION=0
CONFIG_CC_CAN_LINK=y
CONFIG_CC_CAN_LINK_STATIC=y
CONFIG_CC_HAS_ASM_GOTO_OUTPUT=y
CONFIG_CC_HAS_ASM_GOTO_TIED_OUTPUT=y
CONFIG_TOOLS_SUPPORT_RELR=y
CONFIG_CC_HAS_ASM_INLINE=y
CONFIG_CC_HAS_NO_PROFILE_FN_ATTR=y
